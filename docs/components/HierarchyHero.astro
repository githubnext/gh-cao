---
import WorkflowEcosystem from "./WorkflowEcosystem.astro";
import HeroIntro from "./HeroIntro.astro";
import LandingSlideshow from "./LandingSlideshow.astro";
import TerminalDemo from "./TerminalDemo.astro";
import ThemeImage from "./ThemeImage.astro";
import HeroWorkflowSnippet from "./HeroWorkflowSnippet.astro";
import HeroControlDiagram from "./HeroControlDiagram.astro";
import HeroDecisionLoop from "./HeroDecisionLoop.astro";
import dashboardMobileOverview from "../assets/product/cao-dashboard-mobile-overview.png";
import dashboardMobileOverviewLight from "../assets/product/cao-dashboard-mobile-overview-light.png";
---

<div data-slideshow-slides>
<section class="cao-title-slide" data-slideshow-slide aria-label="Presentation title">
  <p>Monitor. Govern. Scale.</p>
  <h1>Central Agentic Ops</h1>
</section>
<div class="hierarchy-hero" data-slideshow-slide>
  <HeroIntro />

  <div class="hero-visual">
    <figure class="phone-preview" aria-labelledby="mobile-dashboard-preview-title">
      <div class="phone-shell">
        <span class="phone-speaker" aria-hidden="true"></span>
        <ThemeImage
          dark={dashboardMobileOverview}
          light={dashboardMobileOverviewLight}
          alt="Central Agentic Ops mobile dashboard showing weekly workflow rhythm, workflow health, repository coverage, retained issues and pull requests, and observed grader results."
          widths={[390, 780]}
          sizes="(max-width: 42rem) 15rem, (min-width: 90rem) 16rem, 21vw"
          loading="eager"
          class="phone-image"
        />
      </div>
      <figcaption id="mobile-dashboard-preview-title">
        Example Overview snapshot. Runtime signals and grader observations are not verified improvements.
      </figcaption>
    </figure>
  </div>
</div>

<section class="product-story dispatch-story" aria-labelledby="dispatch-title" data-reveal data-slideshow-slide>
  <p class="section-eyebrow">One workflow ecosystem</p>
  <h2 id="dispatch-title">Shared workflows. Clear ownership.</h2>
  <p>
    Enrolled repositories benefit from enterprise-, organization-, and repository-owned workflows working side by side.
    Shared workflows reach each repository without being copied into it, while ownership and scope remain explicit.
  </p>
  <figure class="dispatch-illustration" aria-describedby="dispatch-description">
    <figcaption id="dispatch-description" class="visually-hidden">
      Connectors group organizations within the enterprise and repositories within their organization.
      Enterprise and organization workflows run in their owning control repositories and send declared safe outputs
      directly to enrolled repositories. Repository-owned workflows run locally and produce their own safe outputs alongside shared outputs.
      Labels and layout identify ownership; green marks delivery and completed outputs.
      Reviewed policy governs shared work, not the visual hierarchy.
    </figcaption>
    <WorkflowEcosystem />
  </figure>
</section>

<section class="product-story maintenance-story" aria-labelledby="maintenance-title" data-reveal data-slideshow-slide>
  <div class="product-story-copy">
    <p class="section-eyebrow">One reviewed place</p>
    <h2 id="maintenance-title">Distributed reach. Central upkeep.</h2>
    <p>
      Shared workflows reach many repositories; upkeep stays in one reviewed control repository.
      Review updates and upgrades once, reduce repeated maintenance, and keep the fleet current.{" "}
      <a href="/gh-cao/operations/#update-cao">Maintain your control plane.</a>
    </p>
    <dl class="maintenance-steps">
      <div>
        <dt><span aria-hidden="true">01</span> gh-aw upgrades</dt>
        <dd>
          Upgrade gh-aw, migrate deprecated fields, refresh action versions, and recompile workflows with{" "}
          <a href="https://github.github.com/gh-aw/setup/cli/#upgrade"><code>gh aw upgrade</code></a>.
        </dd>
      </div>
      <div>
        <dt><span aria-hidden="true">02</span> Workflow source updates</dt>
        <dd>
          Update one or all source-tracked workflows with{" "}
          <a href="https://github.github.com/gh-aw/setup/cli/#update"><code>gh aw update</code></a>.
          Version pins keep installs reproducible; 3-way merges preserve local customizations.
        </dd>
      </div>
      <div>
        <dt><span aria-hidden="true">03</span> CAO campaign updates</dt>
        <dd>
          Review <code>gh cao update</code> proposals in the control repository, commit one atomic runtime revision,
          and validate a bounded target before rollout.
        </dd>
      </div>
    </dl>
  </div>
  <figure class="product-frame product-shot maintenance-board" data-slideshow-snippet="Dashboard maintenance">
    <picture data-theme-picture>
      <source
        data-theme-source="light"
        media="(prefers-color-scheme: light)"
        srcset="https://github.com/user-attachments/assets/657ba313-28cd-46b4-9246-ae3b4826651a"
      />
      <source
        data-theme-source="dark"
        media="(prefers-color-scheme: dark)"
        srcset="https://github.com/user-attachments/assets/5dc87083-d2dc-4036-82fc-332ddb7bf569"
      />
      <img
        src="https://github.com/user-attachments/assets/5dc87083-d2dc-4036-82fc-332ddb7bf569"
        width="1240"
        height="911"
        alt="CAO dashboard Maintenance Updates page showing repositories with individual Upgrade buttons and Upgrade all. Version evidence is explicitly marked unavailable."
        class="maintenance-image"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <figcaption>Example snapshot. Dashboard maintenance: Upgrade one repository or Upgrade all. Unknown version evidence stays explicit.</figcaption>
  </figure>
</section>

<section class="product-story terminal-story" aria-labelledby="terminal-title" data-reveal data-slideshow-slide>
  <div class="product-story-copy">
    <p class="section-eyebrow">Setup, authentication, and rollout</p>
    <h2 id="terminal-title">Roll out with confidence.</h2>
    <p>
      Start with monitoring. Describe the outcome, target scope, and execution requirements; derive the simplest structure.
      The example adds the Dependabot campaign, pairing a central orchestrator with one-target workers.
      Keep repository scope, read/write credentials and review/live policy explicit.{" "}
      <a href="/gh-cao/operation-patterns/">From outcome to execution.</a>
    </p>
  </div>
  <TerminalDemo />
</section>

<section class="product-story decision-story" aria-labelledby="decision-title" data-reveal data-slideshow-slide>
  <div class="product-story-copy">
    <span id="evidence-title"></span><span id="operational-value-title"></span>
    <p class="section-eyebrow">Operational value</p>
    <h2 id="decision-title">Use evidence to decide what scales.</h2>
    <p>
      Review outcomes, reliability, and cost. Refine what needs work, expand what earns confidence,
      and pause what does not.
    </p>
    <a class="hero-story-link" href="/gh-cao/operational-value-how-to/">
      Explore operational value <span aria-hidden="true">→</span>
    </a>
  </div>
  <HeroDecisionLoop />
</section>
<section class="product-story snippet-story webhook-story" aria-labelledby="webhook-title" data-reveal data-slideshow-slide>
  <div class="product-story-copy">
    <p class="section-eyebrow">Events here. Workflows there.</p>
    <h2 id="webhook-title">Webhook Gateway</h2>
    <p>
      Dispatch events across repositories: an event in one enrolled repository can trigger an approved workflow in another.
      Authenticate, queue, and batch deliveries within reviewed enrollment and fresh access checks.
    </p>
    <a class="hero-story-link" href="https://github.com/githubnext/gh-cao/blob/main/server/README.md#webhook-gateway-operations">
      Explore the Webhook Gateway <span aria-hidden="true">→</span>
    </a>
  </div>
  <HeroControlDiagram />
</section>

<section class="product-story snippet-story agentic-workflows-story" aria-labelledby="agentic-workflows-title" data-reveal data-slideshow-slide>
  <div class="product-story-copy">
    <p class="section-eyebrow">The foundation underneath CAO</p>
    <h2 id="agentic-workflows-title">Built on Agentic Workflows</h2>
    <p>
      Author workflows in Markdown. GitHub Agentic Workflows runs them in GitHub Actions with declared permissions and safe outputs.
      CAO adds visibility and policy for explicitly integrated workflows.
    </p>
    <a class="hero-story-link" href="https://github.github.com/gh-aw/">
      Explore GitHub Agentic Workflows <span aria-hidden="true">→</span>
    </a>
  </div>
  <HeroWorkflowSnippet
    label="Illustrative example: from a prompt to a campaign to bounded repository work"
    prompt="Roll out a Dependabot campaign across enrolled repositories. Keep it disabled and review-only."
    filename="dependabot/aw.yml"
    code={`name: Dependabot
includes:
  - operational-value.mjs
  - operational-value/dependabot-update-planner.mjs
  - .github/workflows/dependabot.md
  - .github/workflows/dependabot-update-planner.md`}
    transition="After installation, before enabling execution"
    resultTitle="Campaign prepared for review"
    result="A central orchestrator selects admitted repositories. Each worker handles one target."
    caption="Campaign manifest excerpt. Reviewed policy controls scope, enablement, and review/live mode."
  />
</section>
</div>
<LandingSlideshow />

<script>
  const revealTargets = document.querySelectorAll<HTMLElement>("[data-reveal]");

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && revealTargets.length > 0) {
    revealTargets.forEach((target) => target.classList.add("reveal-pending"));

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          // Keep stories revealed above the viewport, but reset them below it.
          const visible = entry.isIntersecting || entry.boundingClientRect.top < 0;
          entry.target.classList.toggle("is-visible", visible);
          entry.target.classList.toggle("reveal-pending", !visible);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
    );

    revealTargets.forEach((target) => observer.observe(target));
  }
</script>

<style>
  @layer starlight.core {
    .cao-title-slide { display: none; }

    :global(.content-panel:has(.hierarchy-hero)) {
      --cao-page-bg: #f7faf8;
      --cao-page-grid-minor: rgba(26, 127, 55, 0.025);
      --cao-page-grid-major: rgba(26, 127, 55, 0.065);
      --cao-page-glow: rgba(26, 127, 55, 0.08);
      --cao-page-secondary-glow: rgba(26, 127, 55, 0.055);
      --cao-phone-bg: #d8dee4;
      --cao-phone-border: #8c959f;
      --cao-phone-inset: rgba(255, 255, 255, 0.72);
      --cao-phone-shadow: rgba(31, 35, 40, 0.2);
      --cao-phone-speaker: #6e7781;
      --cao-section-bg: rgba(255, 255, 255, 0.84);
      --cao-section-border: rgba(31, 35, 40, 0.12);
      --cao-section-shadow: 0 0.5rem 2rem rgba(31, 35, 40, 0.05);
      --cao-section-accent-start: 12%;
      --cao-section-accent-end: 5%;
      --cao-section-glow-strength: 24%;
      --cao-story-heading: #1f2328;
      --cao-story-text: #4d5560;
      --cao-story-eyebrow: #3d444d;
      --cao-product-label: #59636e;
      --cao-loop-text: #1f2328;
      --cao-loop-muted: #59636e;
      --cao-loop-border: #afb8c1;
      padding-inline: 0;
      background-color: var(--cao-page-bg);
      background-image:
        radial-gradient(circle at 76% 7%, var(--cao-page-glow), transparent 31rem),
        radial-gradient(circle at 12% 42%, var(--cao-page-secondary-glow), transparent 27rem),
        linear-gradient(var(--cao-page-grid-major) 1px, transparent 1px),
        linear-gradient(90deg, var(--cao-page-grid-major) 1px, transparent 1px),
        linear-gradient(var(--cao-page-grid-minor) 1px, transparent 1px),
        linear-gradient(90deg, var(--cao-page-grid-minor) 1px, transparent 1px);
      background-position: center top;
      background-size: auto, auto, 160px 160px, 160px 160px, 32px 32px, 32px 32px;
    }

    :global(:root[data-theme="dark"] .content-panel:has(.hierarchy-hero)) {
      --cao-page-bg: #000000;
      --cao-phone-bg: #21262d;
      --cao-phone-border: #57606a;
      --cao-phone-inset: rgba(255, 255, 255, 0.07);
      --cao-phone-shadow: rgba(0, 0, 0, 0.3);
      --cao-phone-speaker: #8c959f;
      --cao-section-bg: rgba(13, 17, 23, 0.84);
      --cao-section-border: rgba(240, 246, 252, 0.15);
      --cao-section-shadow: 0 0.5rem 2rem rgba(0, 0, 0, 0.18);
      --cao-story-heading: #f0f6fc;
      --cao-story-text: #b1bac4;
      --cao-story-eyebrow: #b1bac4;
      --cao-product-label: #a4aea6;
      --cao-loop-text: #f0f6fc;
      --cao-loop-muted: #b1bac4;
      --cao-loop-border: #30363d;
      background-image: none;
    }

    :global(.sl-container:has(> [data-slideshow-slides])) {
      width: 100%;
      max-width: none;
      padding-inline: 0;
    }

    .hierarchy-hero {
      --cao-hero-bg: #ffffff;
      --cao-hero-fg: #1f2328;
      --cao-hero-muted: #4d5560;
      --cao-hero-accent: #0969da;
      --cao-hero-border: #d0d7de;
      --cao-secondary-bg: #f6f8fa;
      --cao-secondary-bg-hover: #eaeef2;
      --cao-secondary-border: #d0d7de;
      --cao-secondary-border-hover: #8c959f;
      --cao-hero-glow: rgba(26, 127, 55, 0.1);
      position: relative;
      isolation: isolate;
      display: grid;
      overflow: clip;
      width: min(100%, 76rem);
      margin-inline: auto;
      grid-template-columns: minmax(0, 1fr);
      align-items: center;
      gap: 2.5rem;
      padding: 3.5rem clamp(1rem, 4vw, 3rem);
      background-color: transparent;
      background-image:
        radial-gradient(circle at 50% 100%, var(--cao-hero-glow), transparent 34rem);
      background-position: center top;
      background-size: auto;
      color: var(--cao-hero-fg);
    }

    :global(:root[data-theme="dark"]) .hierarchy-hero {
      --cao-hero-bg: #000000;
      --cao-hero-fg: #f0f6fc;
      --cao-hero-muted: #b1bac4;
      --cao-hero-accent: #58a6ff;
      --cao-hero-border: #21262d;
      --cao-secondary-bg: #21262d;
      --cao-secondary-bg-hover: #30363d;
      --cao-secondary-border: #30363d;
      --cao-secondary-border-hover: #8c959f;
      background-image: none;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .product-frame {
      position: relative;
      overflow: hidden;
      margin: 0;
      border: 1px solid var(--cao-loop-border);
      border-radius: 0.875rem;
      background: #0d1117;
      box-shadow:
        0 1.5rem 4rem rgba(31, 35, 40, 0.16),
        0 0 0 1px color-mix(in srgb, var(--sl-color-text-accent) 8%, transparent);
    }

    .product-frame-bar {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      border-block-end: 1px solid #30363d;
      padding: 0.65rem 0.85rem;
      background: #161b22;
      color: #8c959f;
      font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.625rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .product-frame-status {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      color: #7ee787;
    }

    .product-frame-status::before {
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 50%;
      background: #3fb950;
      box-shadow: 0 0 0.75rem rgba(63, 185, 80, 0.7);
      content: "";
    }

    .hero-visual {
      --phone-width: clamp(14rem, 21vw, 16rem);
      position: relative;
      isolation: isolate;
      display: grid;
      min-height: 0;
      min-width: 0;
      place-items: center;
    }

    .phone-preview {
      position: relative;
      z-index: 1;
      width: var(--phone-width);
      margin: 0;
      filter: drop-shadow(0 1.25rem 2.25rem var(--cao-phone-shadow));
    }

    .phone-preview figcaption {
      margin-top: 1rem;
      color: var(--cao-story-text);
      font-size: 0.8125rem;
      line-height: 1.5;
      text-align: center;
    }

    .phone-shell {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--cao-phone-border);
      border-radius: 1.8rem;
      padding: 0.38rem;
      background: var(--cao-phone-bg);
      box-shadow:
        inset 0 0 0 1px var(--cao-phone-inset),
        0 0 0 1px color-mix(in srgb, var(--cao-phone-border) 45%, transparent);
    }

    .phone-speaker {
      position: absolute;
      z-index: 1;
      top: 0.72rem;
      left: 50%;
      width: 30%;
      height: 0.28rem;
      border-radius: 999px;
      background: var(--cao-phone-speaker);
      transform: translateX(-50%);
    }

    .phone-image {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 1.45rem;
    }

    .product-story {
      width: min(calc(100% - 2rem), 76rem);
      margin: 1.5rem auto;
      padding: clamp(2rem, 4vw, 3.5rem) clamp(1.25rem, 4vw, 3rem);
    }

    [data-reveal] {
      transition:
        opacity 650ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-reveal].reveal-pending {
      opacity: 0;
      transform: translateY(1.25rem);
    }

    [data-reveal].is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .product-story {
      --section-accent: #3fb950;
      position: relative;
      isolation: isolate;
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.7fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: center;
      overflow: hidden;
      border: 1px solid var(--cao-section-border);
      border-radius: 1rem;
      background:
        radial-gradient(
          ellipse 80% 120% at 0% 0%,
          color-mix(in srgb, var(--section-accent) var(--cao-section-accent-start), transparent),
          transparent 70%
        ),
        radial-gradient(
          ellipse 80% 120% at 100% 100%,
          color-mix(in srgb, var(--section-accent) var(--cao-section-accent-end), transparent),
          transparent 72%
        ),
        var(--cao-section-bg);
      box-shadow: var(--cao-section-shadow);
      backdrop-filter: blur(12px);
    }

    .snippet-story {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .hero-story-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      margin-top: 1rem;
      color: var(--sl-color-text-accent);
      font-weight: 600;
      text-underline-offset: 0.2em;
    }

    .hero-story-link:focus-visible {
      outline: 2px solid var(--sl-color-text-accent);
      outline-offset: 4px;
    }

    .terminal-story {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .maintenance-story {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.2fr);
    }

    .dispatch-story {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
      text-align: center;
    }

    .dispatch-story > .section-eyebrow {
      justify-self: center;
    }

    .dispatch-story h2 {
      max-width: none;
      margin-inline: auto;
      text-align: center;
    }

    .dispatch-story > p:not(.section-eyebrow) {
      max-width: 80ch;
      margin: 0 auto;
      color: var(--cao-story-text);
      font-size: clamp(1rem, 1.4vw, 1.125rem);
      line-height: 1.6;
      text-wrap: balance;
    }

    .dispatch-illustration {
      width: min(100%, 72rem);
      margin: 1rem auto 0;
    }

    @media (width > 72rem) {
      .dispatch-illustration {
        width: min(80%, 56rem);
      }

      .dispatch-illustration :global(.workflow-ecosystem) {
        width: auto;
        /* Unlike transform, zoom also reduces the diagram's occupied height. */
        zoom: 0.8;
      }
    }

    .product-story::before {
      position: absolute;
      z-index: -1;
      top: -10rem;
      right: -8rem;
      width: 24rem;
      aspect-ratio: 1;
      border-radius: 50%;
      background:
        radial-gradient(
          circle,
          color-mix(in srgb, var(--section-accent) var(--cao-section-glow-strength), transparent),
          transparent 68%
        );
      content: "";
      pointer-events: none;
      animation: section-glow-drift 10s ease-in-out infinite alternate;
    }

    :global(:root[data-theme="dark"]) .product-story {
      background:
        radial-gradient(ellipse 80% 120% at 0% 0%, rgba(63, 185, 80, 0.16), transparent 70%),
        radial-gradient(ellipse 80% 120% at 100% 100%, rgba(63, 185, 80, 0.1), transparent 72%),
        rgba(13, 17, 23, 0.88);
    }

    :global(:root[data-theme="dark"]) .product-story::before {
      display: none;
    }

    @keyframes section-glow-drift {
      from {
        opacity: 0.7;
        transform: translate3d(0, 0, 0) scale(0.96);
      }
      to {
        opacity: 1;
        transform: translate3d(-1rem, 1rem, 0) scale(1.04);
      }
    }

    .product-shot {
      background: #0d1117;
      box-shadow:
        0 1.5rem 4rem rgba(31, 35, 40, 0.18),
        0 0 0 1px color-mix(in srgb, var(--sl-color-text-accent) 8%, transparent);
      transition:
        transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 350ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .product-shot:hover {
      transform: translateY(-0.3rem) scale(1.008);
      box-shadow:
        0 2rem 5rem rgba(31, 35, 40, 0.24),
        0 0 0 1px color-mix(in srgb, var(--section-accent) 28%, transparent);
    }

    .maintenance-board {
      min-width: 0;
      width: 100%;
      max-width: 42rem;
      justify-self: center;
      margin: 0;
      background: var(--cao-section-bg);
      color: var(--cao-story-text);
    }

    .maintenance-image {
      display: block;
      width: 100%;
      height: auto;
    }

    .maintenance-board figcaption {
      border-top: 1px solid var(--cao-section-border);
      padding: 0.75rem 1rem;
      font-size: 0.75rem;
      line-height: 1.5;
    }

    .maintenance-steps {
      display: grid;
      gap: 1.25rem;
      margin: 1.5rem 0 0;
    }

    .maintenance-steps > div {
      border-top: 1px solid var(--cao-section-border);
      padding-top: 1rem;
    }

    .maintenance-steps dt {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: var(--cao-story-heading);
      font-weight: 600;
    }

    .maintenance-steps dt span {
      color: var(--cao-story-eyebrow);
      font: 600 0.75rem/1.5 "Mona Sans Mono", monospace;
    }

    .maintenance-steps dd {
      margin: 0.5rem 0 0;
      font-size: 0.875rem;
      line-height: 1.6;
    }

    .terminal-story :global(.terminal) {

---
import { Icon } from "@astrojs/starlight/components";
import EditLink from "virtual:starlight/components/EditLink";
import LastUpdated from "virtual:starlight/components/LastUpdated";
import Pagination from "virtual:starlight/components/Pagination";
import ImageZoom from "./ImageZoom.astro";

const year = new Date().getFullYear();
const buildCommit = (import.meta.env.PUBLIC_PAGES_BUILD_COMMIT || "").trim();
const buildCommitShort = buildCommit.slice(0, 7);
---

<footer class="site-footer sl-flex">
  <div class="footer-meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
  <p class="attribution sl-flex">
    Made with
    <span class="sr-only">love</span>
    <Icon name="heart" size="0.875rem" />
    by
    <a href="https://githubnext.com/" target="_blank" rel="noopener noreferrer">GitHub Next</a>
    &amp;
    <a href="https://www.microsoft.com/en-us/research/" target="_blank" rel="noopener noreferrer">Microsoft Research</a>
  </p>
  <div class="legal sl-flex">
    <span>&copy; {year} GitHub, Inc.</span>
    {buildCommitShort && <span class="build-commit">Build commit: <code>{buildCommitShort}</code></span>}
    <nav aria-label="Legal and corporate links" class="legal-links sl-flex">
      <a href="https://docs.github.com/site-policy/github-terms/github-terms-of-service">Terms</a>
      <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement">Privacy</a>
      <a href="https://docs.github.com/site-policy">Legal</a>
      <a href="https://github.com/logos">Brand</a>
    </nav>
  </div>
</footer>
<ImageZoom />

<script>
  function enableSkipLinkFocus() {
    const skipLink = document.querySelector(".sl-skip-link");
    if (!(skipLink instanceof HTMLAnchorElement)) return;
    if (skipLink.dataset.caoSkipFocusBound === "true") return;

    const targetId = skipLink.getAttribute("href")?.startsWith("#") ? skipLink.getAttribute("href").slice(1) : "";
    if (!targetId) return;

    const target = document.getElementById(targetId);
    const fallback = document.querySelector("main");
    if (!(target instanceof HTMLElement) && !(fallback instanceof HTMLElement)) return;

    const ensureFocusable = (element) => {
      if (!(element instanceof HTMLElement)) return null;
      if (!element.hasAttribute("tabindex")) element.setAttribute("tabindex", "-1");
      return element;
    };

    const focusTarget = () => {
      const candidates = [ensureFocusable(target), ensureFocusable(fallback)].filter(Boolean);
      for (const candidate of candidates) {
        candidate.focus({ preventScroll: true });
        if (document.activeElement === candidate) {
          candidate.scrollIntoView({ block: "start" });
          return;
        }
      }
      ensureFocusable(target)?.scrollIntoView({ block: "start" });
    };

    skipLink.addEventListener("click", () => requestAnimationFrame(focusTarget));
    skipLink.dataset.caoSkipFocusBound = "true";
  }

  enableSkipLinkFocus();
  document.addEventListener("astro:page-load", enableSkipLinkFocus);
</script>

<style>
  @layer starlight.components {
    .site-footer {
      flex-direction: column;
      gap: 0.5rem;
      margin-top: 0;
      border-top: 1px solid color-mix(in srgb, var(--sl-color-gray-5) 52%, transparent);
      padding-block: 0.25rem 0.1875rem;
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-xs);
    }

    :global(.sl-markdown-content:empty) {
      display: none;
    }

    .footer-meta {
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.5rem 2rem;
      margin: 0;
    }

    .footer-meta:not(:has(*)),
    .site-footer :global(.pagination-links:not(:has(a))) {
      display: none !important;
    }

    .site-footer :global(.pagination-links) {
      gap: 0.75rem;
      margin: 0 !important;
    }

    .site-footer :global(.pagination-links a) {
      padding: 0.625rem !important;
      box-shadow: none;
    }

    .site-footer :global(.pagination-links .link-title) {
      font-size: var(--sl-text-base) !important;
    }

    .attribution {
      align-items: center;
      align-self: center;
      gap: 0.3rem;
      margin: 0;
      color: #f0f6fc;
      line-height: 1.4;
      white-space: nowrap;
    }

    .attribution :global(svg) {
      color: #3fb950;
    }

    .attribution a {
      color: #58a6ff;
      font-weight: 600;
      text-decoration: none;
    }

    .attribution a:hover {
      color: #79c0ff;
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    .legal {
      align-items: center;
      align-self: center;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.3rem 0.75rem;
      margin-top: 0.125rem;
      line-height: 1.4;
    }

    .legal-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
    }

    .build-commit {
      font-family: var(--sl-font-mono);
    }

    .legal a {
      color: inherit;
      text-decoration: none;
    }

    .legal a:hover {
      color: var(--sl-color-white);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    :global(:root[data-theme="light"]) .attribution {
      color: #1f2328;
    }

    :global(:root[data-theme="light"]) .attribution :global(svg) {
      color: #1a7f37;
    }

    :global(:root[data-theme="light"]) .attribution a {
      color: #0550ae;
    }

    :global(:root[data-theme="light"]) .attribution a:hover {
      color: #0550ae;
    }

    :global(:root[data-theme="light"]) .legal a:hover {
      color: var(--sl-color-black);
    }

    @media (max-width: 30rem) {
      .attribution {
        max-width: calc(100vw - 2rem);
        gap: 0.25rem;
        justify-content: center;
        text-align: center;
        white-space: normal;
      }
    }
  }
</style>
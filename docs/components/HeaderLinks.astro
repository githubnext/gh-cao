---
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import { Icon } from "@astrojs/starlight/components";

const path = Astro.url.pathname;
const { hasSidebar, id } = Astro.locals.starlightRoute;
const links = [
  { label: "Docs", href: "/gh-cao/architecture-at-a-glance/" },
];
---

<nav class="cao-primary-nav" aria-label="Global links">
  {
    links.map(({ label, href }) => (
      <a href={href} aria-current={href.startsWith("/") && path.startsWith(href) ? "page" : undefined}>
        {label}
      </a>
    ))
  }
</nav>
{id === "" && (
  <button type="button" class="slideshow-trigger" data-slideshow-trigger aria-label="Start slideshow" aria-haspopup="dialog" aria-controls="landing-slideshow" title="Start slideshow" hidden>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 3h18M4 3v13h16V3M12 16v5M7 21l5-5 5 5M10 7l5 3-5 3Z" />
    </svg>
  </button>
)}
{
  !hasSidebar && (
    <details class="cao-mobile-nav">
      <summary aria-label="Open global links menu">
        <span class="menu-icon open-menu" aria-hidden="true"><Icon name="bars" /></span>
        <span class="menu-icon close-menu" aria-hidden="true"><Icon name="close" /></span>
      </summary>
      <nav aria-label="Global links menu">
        {links.map(({ label, href }) => (
          <a href={href} aria-current={href.startsWith("/") && path.startsWith(href) ? "page" : undefined}>
            {label}
          </a>
        ))}
      </nav>
    </details>
  )
}
<Default><slot /></Default>

<script>
  const enhanceSkipLink = () => {
    const target = document.getElementById("_top");
    if (!(target instanceof HTMLElement)) return;
    if (!target.hasAttribute("tabindex")) target.tabIndex = -1;

    const focusTarget = () => {
      if (window.location.hash !== "#_top") return;
      requestAnimationFrame(() => {
        target.focus({ preventScroll: true });
      });
    };

    document.querySelectorAll<HTMLAnchorElement>('a.sl-skip-link[href="#_top"]').forEach((link) => {
      if (link.dataset.skipLinkReady === "true") return;
      link.dataset.skipLinkReady = "true";
      link.addEventListener("click", focusTarget);
    });

    focusTarget();
  };

  enhanceSkipLink();
  document.addEventListener("astro:page-load", enhanceSkipLink);
  window.addEventListener("hashchange", enhanceSkipLink);
</script>

<style>
  .slideshow-trigger {
    display: inline-flex;
    order: 1;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }

  .slideshow-trigger:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .slideshow-trigger:focus-visible {
    outline: 3px solid var(--sl-color-accent-high);
    outline-offset: 3px;
  }

  .slideshow-trigger[hidden] { display: none; }

  @media (max-width: 49.999rem) {
    .slideshow-trigger { display: none; }
  }

  @media print {
    .slideshow-trigger { display: none; }
  }

  .cao-primary-nav {
    display: flex;
    order: 1;
    align-items: center;
    gap: 0.1rem;
    margin-inline-end: 0.65rem;
  }

  .cao-primary-nav a {
    border-radius: 0.375rem;
    padding: 0.45rem 0.6rem;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
  }

  .cao-primary-nav a:hover,
  .cao-primary-nav a[aria-current="page"],
  .cao-mobile-nav a:hover,
  .cao-mobile-nav a[aria-current="page"] {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .cao-mobile-nav {
    position: relative;
    display: none;
    order: 4;
  }

  .cao-mobile-nav summary {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    list-style: none;
    background: var(--sl-color-bg-nav);
  }

  .cao-mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .cao-mobile-nav summary:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .cao-mobile-nav summary:focus-visible {
    outline: 3px solid var(--sl-color-accent-high);
    outline-offset: 3px;
    box-shadow: 0 0 0 2px var(--sl-color-bg-nav);
  }

  .cao-mobile-nav .menu-icon {
    display: inline-flex;
  }

  .cao-mobile-nav .close-menu,
  .cao-mobile-nav[open] .open-menu {
    display: none;
  }

  .cao-mobile-nav[open] .close-menu {
    display: inline-flex;
  }

  .cao-mobile-nav nav {
    position: fixed;
    z-index: var(--sl-z-index-menu);
    top: var(--sl-nav-height);
    right: 0;
    left: 0;
    display: grid;
    gap: 0.25rem;
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    padding: 0.75rem var(--sl-nav-pad-x) 1rem;
    background: var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-md);
  }

  .cao-mobile-nav a {
    border-radius: 0.375rem;
    padding: 0.75rem;
    color: var(--sl-color-gray-2);
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 72rem) {
    .cao-primary-nav {
      display: none;
    }

    .cao-mobile-nav {
      display: block;
    }
  }
</style>

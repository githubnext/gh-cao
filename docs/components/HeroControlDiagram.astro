---
import { repoPath } from "./workflow-illustration-icons.mjs";

// Service marks from Simple Icons 11.15.0 (CC0-1.0).
const services = [
  {
    name: "Linear",
    path: "M2.886 4.18A11.982 11.982 0 0 1 11.99 0C18.624 0 24 5.376 24 12.009c0 3.64-1.62 6.903-4.18 9.105L2.887 4.18ZM1.817 5.626l16.556 16.556c-.524.33-1.075.62-1.65.866L.951 7.277c.247-.575.537-1.126.866-1.65ZM.322 9.163l14.515 14.515c-.71.172-1.443.282-2.195.322L0 11.358a12 12 0 0 1 .322-2.195Zm-.17 4.862 9.823 9.824a12.02 12.02 0 0 1-9.824-9.824Z",
  },
  {
    name: "Jira",
    path: "M11.571 11.513H0a5.218 5.218 0 0 0 5.232 5.215h2.13v2.057A5.215 5.215 0 0 0 12.575 24V12.518a1.005 1.005 0 0 0-1.005-1.005zm5.723-5.756H5.736a5.215 5.215 0 0 0 5.215 5.214h2.129v2.058a5.218 5.218 0 0 0 5.215 5.214V6.758a1.001 1.001 0 0 0-1.001-1.001zM23.013 0H11.455a5.215 5.215 0 0 0 5.215 5.215h2.129v2.057A5.215 5.215 0 0 0 24 12.483V1.005A1.001 1.001 0 0 0 23.013 0Z",
  },
  {
    name: "Sentry",
    path: "M13.91 2.505c-.873-1.448-2.972-1.448-3.844 0L6.904 7.92a15.478 15.478 0 0 1 8.53 12.811h-2.221A13.301 13.301 0 0 0 5.784 9.814l-2.926 5.06a7.65 7.65 0 0 1 4.435 5.848H2.194a.365.365 0 0 1-.298-.534l1.413-2.402a5.16 5.16 0 0 0-1.614-.913L.296 19.275a2.182 2.182 0 0 0 .812 2.999 2.24 2.24 0 0 0 1.086.288h6.983a9.322 9.322 0 0 0-3.845-8.318l1.11-1.922a11.47 11.47 0 0 1 4.95 10.24h5.915a17.242 17.242 0 0 0-7.885-15.28l2.244-3.845a.37.37 0 0 1 .504-.13c.255.14 9.75 16.708 9.928 16.9a.365.365 0 0 1-.327.543h-2.287c.029.612.029 1.223 0 1.831h2.297a2.206 2.206 0 0 0 1.922-3.31z",
  },
  {
    name: "Azure DevOps",
    path: "M0 8.877L2.247 5.91l8.405-3.416V.022l7.37 5.393L2.966 8.338v8.225L0 15.707zm24-4.45v14.651l-5.753 4.9-9.303-3.057v3.056l-5.978-7.416 15.057 1.798V5.415z",
  },
];
---

<figure class="control-diagram" aria-label="Service webhook dispatch">
  <div class="diagram-label">Service events. Approved workflows. Explicit authority.</div>
  <div class="diagram-pair source-services" role="group" aria-label="Illustrative service sources">
    {services.map((service) => (
      <div class="diagram-node">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={service.path} /></svg>
        <strong>{service.name}</strong>
      </div>
    ))}
  </div>
  <div class="diagram-connector joined" aria-hidden="true"></div>
  <div class="diagram-node gate-node">
    <span class="node-eyebrow">CAO Webhook Gateway</span>
    <strong>Authenticate. Match. Queue.</strong>
    <div class="evidence-tags"><span>Enrolled routes</span><span>Bounded batches</span><span>Fresh access checks</span></div>
  </div>
  <div class="diagram-connector" aria-hidden="true"><span>Workflow dispatch</span></div>
  <div class="diagram-node destination-repository">
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d={repoPath} /></svg>
    <strong>Control repository</strong>
    <span>Approved agentic workflow</span>
    <span class="node-detail">Runs in the destination repository, not the source service.</span>
  </div>
  <figcaption>
    Illustrative service sources require enrollment and a supported event adapter.
    Destination access and the approved workflow revision are rechecked before dispatch.
  </figcaption>
</figure>

<style>
  @layer starlight.core {
    .control-diagram {
      min-width: 0;
      margin: 0;
      color: var(--cao-story-heading);
    }

    .diagram-label {
      margin-bottom: 1.25rem;
      color: var(--cao-story-text);
      font-size: 0.8125rem;
      text-align: center;
      text-wrap: balance;
    }

    .diagram-pair {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .diagram-node {
      display: flex;
      min-width: 0;
      flex-direction: column;
      align-items: center;
      gap: 0.375rem;
      border: 1px solid var(--cao-loop-border);
      border-radius: 0.5rem;
      padding: 1rem 0.75rem;
      background: var(--cao-section-bg);
      font-size: 0.8125rem;
      text-align: center;
      overflow-wrap: anywhere;
    }

    .diagram-node strong {
      font-size: 0.9375rem;
      font-weight: 600;
    }

    .diagram-node > span,
    figcaption {
      color: var(--cao-story-text);
    }

    .diagram-node svg {
      width: 1.25rem;
      height: 1.25rem;
      flex: 0 0 auto;
      color: var(--sl-color-text-accent);
      fill: currentColor;
    }

    .node-eyebrow {
      font-size: 0.75rem;
      font-weight: 600;
    }

    .gate-node {
      border-color: var(--sl-color-text-accent);
      background: color-mix(in srgb, var(--sl-color-text-accent) 8%, var(--cao-section-bg));
    }

    .evidence-tags {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.375rem;
      margin-top: 0.375rem;
    }

    .evidence-tags span {
      border: 1px solid var(--cao-section-border);
      border-radius: 0.25rem;
      padding: 0.25rem 0.5rem;
      color: var(--cao-story-text);
      font-size: 0.6875rem;
    }

    .diagram-connector {
      position: relative;
      display: grid;
      height: 3rem;
      place-items: center;
    }

    .diagram-connector::before {
      position: absolute;
      inset: 0 auto 0 50%;
      width: 1px;
      background: var(--cao-loop-border);
      content: "";
    }

    .diagram-connector::after {
      position: absolute;
      bottom: 0.125rem;
      left: calc(50% - 0.2rem);
      width: 0.4rem;
      height: 0.4rem;
      border-right: 1px solid var(--cao-loop-border);
      border-bottom: 1px solid var(--cao-loop-border);
      content: "";
      transform: rotate(45deg);
    }

    .diagram-connector > span {
      z-index: 1;
      border: 1px solid var(--cao-section-border);
      border-radius: 0.25rem;
      padding: 0.15rem 0.5rem;
      background: var(--cao-page-bg);
      color: var(--cao-story-text);
      font-size: 0.6875rem;
    }

    .joined::before {
      inset: 0 25% 50%;
      width: auto;
      border: 1px solid var(--cao-loop-border);
      border-top: 0;
      background: none;
    }

    .joined {
      background: linear-gradient(var(--cao-loop-border), var(--cao-loop-border)) center bottom / 1px 50% no-repeat;
    }

    .node-detail {
      max-width: 30ch;
      font-size: 0.75rem;
    }

    figcaption {
      margin-top: 1rem;
      font-size: 0.75rem;
      line-height: 1.5;
      text-align: center;
      text-wrap: balance;
    }
  }
</style>

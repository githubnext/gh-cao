---
import repoAssistAgent from "../assets/repo-assist-agent.png";
import repoAssistTrail from "../assets/repo-assist-trail.png";

// Approximate traces reconstructed from the supplied slide, not measured run data.
const days = [-100, -96, -92, -80, -78, -64, -62, -40, -18, -3, 0, 2, 4, 7, 12, 16, 22, 28, 36, 44, 52, 60, 68, 76, 80];
const repositories = [
  { name: "FSharp.Data", values: [115, 115, 122, 122, 102, 102, 100, 100, 100, 100, 100, 84, 92, 75, 45, 50, 50, 60, 52, 48, 44, 48, 38, 32, 32] },
  { name: "Deedle", values: [103, 103, 104, 104, 104, 104, 103, 103, 101, 100, 100, 80, 68, 72, 72, 68, 69, 88, 55, 55, 40, 40, 38, 33, 33] },
  { name: "SwaggerProvider", values: [101, 101, 108, 112, 108, 101, 101, 101, 101, 101, 100, 83, 87, 60, 55, 29, 29, 38, 20, 28, 28, 28, 23, 23, 20] },
  { name: "FSharp.Formatting", values: [100, 100, 100, 101, 100, 100, 99, 99, 99, 99, 100, 60, 37, 39, 32, 15, 15, 15, 18, 14, 14, 14, 14, 16, 19] },
  { name: "FSharp.Control.AsyncSeq", values: [99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 100, 20, 20, 20, 20, 21, 21, 10, 10, 10, 8, 8, 10, 10, 10] },
  { name: "GenPRES", values: [80, 80, 80, 80, 80, 80, 80, 86, 86, 86, 100, 72, 79, 74, 71, 72, 45, 50, 45, 40, 49, 40, 16, 14, 14] },
  { name: "FSharp.TypeProviders.SDK", values: [98, 98, 98, 98, 98, 98, 96, 96, 96, 96, 100, 8, 8, 20, 30, 8, 3, 3, 3, 3, 3, 2, 3, 3, 3] },
  { name: "FSharp.Control.TaskSeq", values: [102, 102, 102, 122, 122, 122, 118, 122, 94, 94, 100, 83, 70, 5, 3, 4, 6, 6, 3, 4, 3, 4, 2, 4, 4] },
  { name: "licensee", dashed: true, values: [100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 104, 104, 104, 101, 104, 103, 102, 100, 98, 100, 100, 98, 91, 90] },
  { name: "fantomas", dashed: true, checked: true, values: [100, 100, 100, 100, 101, 101, 100, 100, 100, 100, 100, 100, 98, 98, 97, 96, 99, 97, 97, 95, 96, 95, 95, 94, 93] },
  { name: "FsAutoComplete", dashed: true, checked: true, values: [98, 98, 99, 99, 99, 99, 99, 99, 99, 99, 100, 89, 85, 86, 86, 84, 90, 92, 79, 78, 82, 82, 82, 82, 82] },
  { name: "dowhy", dashed: true, checked: true, values: [101, 101, 101, 101, 101, 101, 101, 101, 101, 101, 100, 93, 88, 80, 82, 81, 80, 82, 80, 78, 69, 68, 65, 62, 62] },
  { name: "fsharp", values: [100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 80, 83, 85, 70, 7, 6, 7, 16, 16, 16, 20, 10, 12, 12] },
  { name: "FSharp.Stats", checked: true, values: [100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 65, 45, 38, 25, 22, 19, 18, 17, 15, 15, 17, 15, 16, 17] },
];
const x = (day: number) => 90 + (day + 100) / 180 * 780;
const y = (value: number) => 500 - value / 130 * 420;
const trace = (values: number[]) => values.map((value, index) => `${index ? "L" : "M"}${x(days[index]).toFixed(1)},${y(value).toFixed(1)}`).join(" ");
---

<figure class="repo-assist-chart" aria-labelledby="repo-assist-caption">
  <div class="repo-assist-visual">
    <div class="repository-legend">
      <h3>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h14v18H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm0 0v14h14M8 17v6l3-2 3 2v-6" /></svg>
        Repositories
      </h3>
      <ul aria-label="Repositories shown in the reconstructed chart">
        {repositories.map(repository => (
          <li>
            <svg class:list={["legend-line", { dashed: repository.dashed }]} viewBox="0 0 30 12" aria-hidden="true"><path d="M0 6h30" /></svg>
            <span>{repository.name}</span>
            {repository.checked && <svg class="legend-check" viewBox="0 0 20 20" aria-label="Check mark in the reference slide" role="img"><circle cx="10" cy="10" r="8" /><path d="m6 10 3 3 5-7" /></svg>}
          </li>
        ))}
      </ul>
    </div>
    <div class="chart-scroll" role="region" aria-label="Issue burndown chart; scroll horizontally on small screens" tabindex="0">
      <svg class="burndown-plot" viewBox="0 0 1000 600" role="img" aria-labelledby="repo-assist-plot-title" aria-describedby="repo-assist-plot-description">
        <title id="repo-assist-plot-title">Open issues before and after Repo Assist adoption</title>
        <desc id="repo-assist-plot-description">Reconstructed from the supplied presentation slide. Fourteen repository traces are normalized to 100 percent on adoption day. Before adoption most stay near 100 percent; afterward many fall sharply, while some decline more slowly. Three purple and blue flying agent figures with pale curved lightning trails decorate the right edge. Coordinates are illustrative, not original measurements, and do not establish causation.</desc>
        <g class="plot-grid" aria-hidden="true">
          {[0, 20, 40, 60, 80, 100, 120].map(value => <path d={`M90 ${y(value)}H870`} />)}
        </g>
        <g class="plot-axes" aria-hidden="true">
          <path d="M90 80V500H870" />
          {[0, 20, 40, 60, 80, 100, 120].map(value => <text x="78" y={y(value) + 6} text-anchor="end">{value}%</text>)}
          {[-80, -60, -40, -20, 0, 20, 40, 60, 80].map(day => <text x={x(day)} y="530" text-anchor="middle">{day}</text>)}
          <text x="480" y="578" text-anchor="middle">Days Before / After Repo-Assist Adoption</text>
          <text transform="translate(24 290) rotate(-90)" text-anchor="middle">Open issues (% of count at adoption)</text>
        </g>
        <g class="repository-traces" fill="none" aria-hidden="true">
          {repositories.map(repository => <path d={trace(repository.values)} class:list={{ dashed: repository.dashed }} />)}
        </g>
        <g class="adoption-marker" aria-hidden="true">
          <path d={`M${x(0)} 78V502`} />
          <rect x={x(0) - 114} y="14" width="228" height="52" rx="26" />
          <g transform={`translate(${x(0) - 94} 30)`}><path d="M0 2h20v20H0ZM0 8h20M4-2v7M16-2v7" /></g>
          <text x={x(0) + 16} y="48" text-anchor="middle">Adoption day</text>
        </g>
        <g class="flying-agents" aria-hidden="true">
          <g class="flying-agent" transform="translate(835 122) rotate(-5 82 45)">
            <image class="agent-trail" href={repoAssistTrail.src} x="0" y="26" width="112" height="46" />
            <image class="agent-figure" href={repoAssistAgent.src} x="75" y="0" width="90" height="90" />
          </g>
          <g class="flying-agent" transform="translate(840 249)">
            <image class="agent-trail" href={repoAssistTrail.src} x="0" y="26" width="112" height="46" />
            <image class="agent-figure" href={repoAssistAgent.src} x="75" y="0" width="90" height="90" />
          </g>
          <g class="flying-agent" transform="translate(834 373) rotate(5 82 45)">
            <image class="agent-trail" href={repoAssistTrail.src} x="0" y="26" width="112" height="46" />
            <image class="agent-figure" href={repoAssistAgent.src} x="75" y="0" width="90" height="90" />
          </g>
        </g>
      </svg>
    </div>
  </div>
  <figcaption id="repo-assist-caption">
    Burning down open issues in F# repositories with the “Repo Assist” workflow.
    <span>Visual reconstruction of the supplied slide. Traces are approximate; original measurements were not provided. This is not live CAO data or evidence of causation.</span>
  </figcaption>
</figure>

<style>
  .repo-assist-chart {
    --chart-ink: var(--cao-story-heading);
    --chart-muted: var(--cao-story-text);
    --chart-line: var(--cao-story-text);
    --chart-accent: var(--sl-color-text-accent);
    width: 100%;
    max-width: 70rem;
    min-width: 0;
    margin: 0 auto;
  }
  .repo-assist-visual { display: grid; grid-template-columns: minmax(12rem, 0.9fr) minmax(0, 3fr); gap: 1rem; align-items: center; }
  .repository-legend { min-width: 0; }
  .repository-legend h3 { display: flex; align-items: center; gap: 0.6rem; width: fit-content; margin: 0 0 1.25rem; padding: 0.6rem 1rem; border: 1px solid var(--cao-loop-border); border-radius: 0.5rem; background: var(--cao-section-bg); color: var(--chart-ink); font-size: 0.95rem; }
  .repository-legend h3 svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .repository-legend ul { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .repository-legend li { display: flex; align-items: center; gap: 0.5rem; margin: 0; color: var(--chart-muted); font-size: 0.75rem; overflow-wrap: anywhere; }
  .legend-line { flex: 0 0 1.5rem; width: 1.5rem; height: 0.75rem; fill: none; stroke: var(--chart-line); stroke-width: 2; }
  .dashed { stroke-dasharray: 7 7; }
  .legend-check { flex: 0 0 1rem; width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .chart-scroll { min-width: 0; overflow-x: auto; }
  .chart-scroll:focus-visible { outline: 2px solid var(--chart-accent); outline-offset: -2px; border-radius: 0.5rem; }
  .burndown-plot { display: block; width: 100%; min-width: 40rem; height: auto; overflow: visible; }
  .plot-grid { fill: none; stroke: var(--cao-section-border); stroke-width: 1; }
  .plot-axes { fill: var(--chart-ink); font-family: var(--sl-font); font-size: 18px; }
  .plot-axes path { fill: none; stroke: var(--chart-muted); stroke-width: 1.5; }
  .repository-traces { stroke: var(--chart-line); stroke-width: 1.8; stroke-linejoin: round; }
  .repository-traces path:nth-child(3n) { opacity: 0.7; }
  .adoption-marker { fill: none; stroke: var(--chart-accent); stroke-width: 2.5; }
  .adoption-marker rect { fill: var(--cao-page-bg); }
  .adoption-marker text { fill: var(--chart-ink); stroke: none; font-family: var(--sl-font); font-size: 20px; font-weight: 600; }
  .adoption-marker g { stroke: var(--chart-ink); stroke-width: 1.5; }
  .agent-trail, .agent-figure { pointer-events: none; }
  figcaption { margin-top: 1rem; color: var(--chart-muted); font-size: 0.875rem; line-height: 1.6; text-align: center; }
  figcaption span { display: block; margin-top: 0.4rem; font-size: 0.75rem; }
  @media (max-width: 60rem) {
    .repo-assist-visual { grid-template-columns: minmax(0, 1fr); }
    .repository-legend { order: 1; }
    .repository-legend ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .repository-legend h3 { margin-bottom: 0.75rem; }
  }
  @media (max-width: 25rem) {
    .repository-legend ul { grid-template-columns: minmax(0, 1fr); }
  }
</style>

---
import type { HTMLAttributes } from "astro/types";

const PAGE_TITLE_ID = "_top";

type HeroAction = {
  attrs?: Omit<HTMLAttributes<"a">, "href">;
  icon?: { name?: string; html?: string };
  link: string;
  text: string;
  variant?: "primary" | "secondary" | "minimal";
};
type HeroData = {
  title: string;
  draft?: boolean;
  hero?: {
    title?: string;
    tagline?: string;
    actions?: HeroAction[];
  };
};

const { data } = (Astro.locals as unknown as { starlightRoute: { entry: { data: HeroData } } }).starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="docs-hero-intro sl-flex">
  <div class="sl-flex copy">
    {
      title !== data.title && (
        <p class="product-name">
          <span class="product-name-sizer" aria-hidden="true">{data.title}</span>
          <span class="product-name-animation" aria-hidden="true" data-product-name-animation data-text={data.title}>
            <span class="product-name-text" data-product-name-text>{data.title}</span>
            <span class="product-name-cursor"></span>
          </span>
        </p>
      )
    }
    <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
    {data.draft && <aside class="draft-notice">This page is a draft and may contain incomplete content.</aside>}
    {tagline && <div class="tagline" set:html={tagline} />}
  </div>
  {
    actions.length > 0 && (
      <div class="sl-flex actions">
        {actions.map(
          ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <a href={href} class:list={["hero-action", variant || "primary", className]} {...attrs}>
              {text}
              {icon?.html ? <Fragment set:html={icon.html} /> : icon?.name === "right-arrow" && <span aria-hidden="true">→</span>}
            </a>
          ),
        )}
      </div>
    )
  }
</div>

<script>
  const TYPE_DELAY_MS = 900;
  const CHARACTER_INTERVAL_MS = 32;
  const TRANSIENT_GLYPHS = ["*", "_", ""];

  function initProductNameAnimation() {
    document.querySelectorAll<HTMLElement>("[data-product-name-animation]").forEach((animation) => {
      if (animation.dataset.animationReady === "true") return;
      animation.dataset.animationReady = "true";

      const output = animation.querySelector<HTMLElement>("[data-product-name-text]");
      const cursor = animation.querySelector<HTMLElement>(".product-name-cursor");
      const text = animation.dataset.text || "";
      if (!output || !text || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      output.textContent = "";
      let index = 0;

      window.setTimeout(function typeNextCharacter() {
        cursor?.classList.add("is-animated");
        index += 1;
        const transientGlyph =
          index < text.length ? TRANSIENT_GLYPHS[index % TRANSIENT_GLYPHS.length] : "";
        output.textContent = `${text.slice(0, index)}${transientGlyph}`;
        if (index < text.length) window.setTimeout(typeNextCharacter, CHARACTER_INTERVAL_MS);
      }, TYPE_DELAY_MS);
    });
  }

  initProductNameAnimation();
  document.addEventListener("astro:page-load", initProductNameAnimation);
</script>

<style>
  @layer starlight.core {
    .docs-hero-intro {
      flex-direction: column;
      gap: 1.5rem;
      text-align: center;
    }

    .copy {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .copy > * {
      max-width: 54ch;
    }

    .product-name {
      position: relative;
      display: inline-flex;
      margin: 0;
      color: var(--cao-product-label);
      font-family: "Mona Sans Mono", monospace;
      font-size: 14px;
      font-weight: 600;
      line-height: 21px;
      letter-spacing: 0.21px;
      white-space: nowrap;
    }

    .product-name-sizer {
      visibility: hidden;
    }

    .product-name-animation {
      position: absolute;
      inset: 0 auto auto 0;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .product-name-text {
      display: block;
      white-space: nowrap;
    }

    .product-name-cursor {
      display: block;
      width: 9px;
      height: 14px;
      flex: 0 0 auto;
      align-self: center;
      background: #5fed83;
    }

    .product-name-cursor.is-animated {
      animation: product-name-cursor-blink 833ms steps(1, end) 250ms 3 forwards;
    }

    h1 {
      max-width: 20ch;
      background: none;
      color: var(--cao-hero-fg);
      font-size: clamp(2.75rem, 5vw, 3.5rem) !important;
      font-weight: 500 !important;
      line-height: 1.1 !important;
      letter-spacing: -0.03em;
      text-wrap: balance;
      -webkit-text-fill-color: currentColor;
      hyphens: none !important;
      overflow-wrap: normal !important;
      word-break: normal !important;
    }

    .tagline {
      max-width: 50ch;
      margin-block-start: 0.25rem;
      color: var(--cao-hero-muted);
      font-size: clamp(1rem, 1.5vw, 1.125rem) !important;
      line-height: 1.65 !important;
    }

    .draft-notice {
      border-inline-start: 0.25rem solid var(--sl-color-orange);
      padding-inline-start: 1rem;
      color: var(--sl-color-gray-2);
    }

    .actions {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
    }

    .hero-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.75rem;
      gap: 0.5em;
      border: 1px solid transparent;
      border-radius: 6px;
      padding: 0.7rem 1.15rem;
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.25;
      text-decoration: none;
      outline-offset: 0.25rem;
    }

    .hero-action :global(svg),
    .hero-action > span {
      width: 1rem;
      height: 1rem;
      flex: 0 0 auto;
      font-size: 1rem;
      line-height: 1;
    }

    .hero-action.primary {
      border-color: #176f32;
      background: #176f32;
      color: #fff;
    }

    .hero-action.primary:hover {
      border-color: #1f883d;
      background: #1f883d;
    }

    .hero-action.secondary {
      border-color: var(--cao-secondary-border);
      background: var(--cao-secondary-bg);
      color: var(--cao-hero-fg);
    }

    .hero-action.secondary:hover {
      border-color: var(--cao-secondary-border-hover);
      background: var(--cao-secondary-bg-hover);
    }

    .hero-action.minimal {
      color: var(--sl-color-white);
    }

    h1,
    .tagline,
    .actions {
      animation: hero-item-enter 650ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    h1 {
      animation-delay: 80ms;
    }

    .tagline {
      animation-delay: 160ms;
    }

    .actions {
      animation-delay: 240ms;
    }

    :global(#landing-slideshow[open]) :is(h1, .tagline, .actions) {
      animation: none;
    }

    @keyframes hero-item-enter {
      from { transform: translateY(0.75rem); }
      to { transform: translateY(0); }
    }

    @keyframes product-name-cursor-blink {
      0%, 49%, 100% { opacity: 1; }
      50%, 99% { opacity: 0; }
    }

    @media (max-width: 42rem) {
      h1 {
        font-size: clamp(2rem, 8.5vw, 2.75rem) !important;
      }

      .actions {
        gap: 0.625rem;
      }

      .hero-action {
        padding-inline: 0.875rem;
        font-size: 0.875rem;
      }
    }

    @media (max-height: 48rem) and (min-width: 42.01rem) {
      .docs-hero-intro {
        gap: 1rem;
      }

      .copy {
        gap: 0.5rem;
      }

      .product-name {
        font-size: 1rem;
      }

      h1 {
        font-size: clamp(2.25rem, 4vw, 3rem) !important;
      }

      .tagline {
        font-size: 1rem !important;
        line-height: 1.4 !important;
      }

      .hero-action {
        padding: 0.55rem 1rem;
        font-size: 0.9rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      h1,
      .tagline,
      .actions {
        animation: none;
      }

      .product-name-cursor.is-animated {
        animation: none;
      }
    }

    @media (min-width: 64rem) {
      .docs-hero-intro {
        max-width: 54rem;
        margin-inline: auto;
      }
    }
  }
</style>
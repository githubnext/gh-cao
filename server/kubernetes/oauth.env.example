# Register a GitHub OAuth app at https://github.com/settings/applications/new
# Homepage URL: https://localhost:8443
# Authorization callback URL: https://localhost:8443/auth/callback
# Copy this file to a private, ignored location before adding real credentials.
CAO_GITHUB_CLIENT_ID=REPLACE_WITH_YOUR_OAUTH_CLIENT_ID
CAO_GITHUB_CLIENT_SECRET=REPLACE_WITH_YOUR_OAUTH_CLIENT_SECRET
CAO_GITHUB_ALLOWED_USERS=REPLACE_WITH_YOUR_GITHUB_LOGIN
CAO_GITHUB_ADMIN_USERS=REPLACE_WITH_YOUR_GITHUB_LOGIN

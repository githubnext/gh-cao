.create-or-alter function cao_ReadySessions() {
    SessionVersions
    | summarize arg_max(SourceRevision, *) by Namespace, RunId
};
.create-or-alter function cao_SessionFacts() {
    SessionFacts
    | summarize take_any(*) by Namespace, RunId, RunAttempt, ProjectionId, RowDigest
    | join kind=inner (cao_ReadySessions() | project Namespace, RunId, ProjectionId) on Namespace, RunId, ProjectionId
};
.create-or-alter function cao_ToolEvents() {
    ToolEvents
    | summarize take_any(*) by Namespace, RunId, RunAttempt, ProjectionId, RowDigest
    | join kind=inner (cao_ReadySessions() | project Namespace, RunId, ProjectionId) on Namespace, RunId, ProjectionId
};
.create-or-alter function cao_FirewallEvents() {
    FirewallEvents
    | summarize take_any(*) by Namespace, RunId, RunAttempt, ProjectionId, RowDigest
    | join kind=inner (cao_ReadySessions() | project Namespace, RunId, ProjectionId) on Namespace, RunId, ProjectionId
};
.create-or-alter function cao_GraderObservations() {
    GraderObservations
    | summarize take_any(*) by Namespace, RunId, RunAttempt, ProjectionId, RowDigest
    | join kind=inner (cao_ReadySessions() | project Namespace, RunId, ProjectionId) on Namespace, RunId, ProjectionId
};
.create-or-alter function cao_EvalObservations() {
    EvalObservations
    | summarize take_any(*) by Namespace, RunId, RunAttempt, ProjectionId, RowDigest
    | join kind=inner (cao_ReadySessions() | project Namespace, RunId, ProjectionId) on Namespace, RunId, ProjectionId
};

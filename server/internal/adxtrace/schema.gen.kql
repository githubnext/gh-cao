// Generated from server/spec/trace.tsp. Do not edit.
.create-merge table TraceEvents (Namespace:string, RunId:string, RunAttempt:long, ProjectionId:string, RowDigest:string, ContractVersion:long, Sequence:long, Type:string, EventId:string, ParentId:string, EpisodeId:string, HopId:string, ParentHopId:string, ToolCallId:string, SessionId:string, Timestamp:string, PartCount:long, ContentDigest:string);
.create-or-alter table TraceEvents ingestion json mapping 'cao_v1' '[{"column":"Namespace","Properties":{"Path":"$.Namespace"}},{"column":"RunId","Properties":{"Path":"$.RunId"}},{"column":"RunAttempt","Properties":{"Path":"$.RunAttempt"}},{"column":"ProjectionId","Properties":{"Path":"$.ProjectionId"}},{"column":"RowDigest","Properties":{"Path":"$.RowDigest"}},{"column":"ContractVersion","Properties":{"Path":"$.ContractVersion"}},{"column":"Sequence","Properties":{"Path":"$.Sequence"}},{"column":"Type","Properties":{"Path":"$.Type"}},{"column":"EventId","Properties":{"Path":"$.EventId"}},{"column":"ParentId","Properties":{"Path":"$.ParentId"}},{"column":"EpisodeId","Properties":{"Path":"$.EpisodeId"}},{"column":"HopId","Properties":{"Path":"$.HopId"}},{"column":"ParentHopId","Properties":{"Path":"$.ParentHopId"}},{"column":"ToolCallId","Properties":{"Path":"$.ToolCallId"}},{"column":"SessionId","Properties":{"Path":"$.SessionId"}},{"column":"Timestamp","Properties":{"Path":"$.Timestamp"}},{"column":"PartCount","Properties":{"Path":"$.PartCount"}},{"column":"ContentDigest","Properties":{"Path":"$.ContentDigest"}}]';
.alter table TraceEvents policy streamingingestion enable;
.alter-merge table TraceEvents policy retention softdelete = 7d recoverability = enabled;

.create-merge table TraceSampleFrames (Namespace:string, RunId:string, RunAttempt:long, ProjectionId:string, RowDigest:string, ContractVersion:long, SourceRevision:long, Repository:string, Day:string, Cutoff:datetime, Mode:string, SeedDigest:string, Algorithm:string, Population:long, Selected:long, SourceGaps:long, Excluded:long, MembershipDigest:string, State:string);
.create-or-alter table TraceSampleFrames ingestion json mapping 'cao_v1' '[{"column":"Namespace","Properties":{"Path":"$.Namespace"}},{"column":"RunId","Properties":{"Path":"$.RunId"}},{"column":"RunAttempt","Properties":{"Path":"$.RunAttempt"}},{"column":"ProjectionId","Properties":{"Path":"$.ProjectionId"}},{"column":"RowDigest","Properties":{"Path":"$.RowDigest"}},{"column":"ContractVersion","Properties":{"Path":"$.ContractVersion"}},{"column":"SourceRevision","Properties":{"Path":"$.SourceRevision"}},{"column":"Repository","Properties":{"Path":"$.Repository"}},{"column":"Day","Properties":{"Path":"$.Day"}},{"column":"Cutoff","Properties":{"Path":"$.Cutoff"}},{"column":"Mode","Properties":{"Path":"$.Mode"}},{"column":"SeedDigest","Properties":{"Path":"$.SeedDigest"}},{"column":"Algorithm","Properties":{"Path":"$.Algorithm"}},{"column":"Population","Properties":{"Path":"$.Population"}},{"column":"Selected","Properties":{"Path":"$.Selected"}},{"column":"SourceGaps","Properties":{"Path":"$.SourceGaps"}},{"column":"Excluded","Properties":{"Path":"$.Excluded"}},{"column":"MembershipDigest","Properties":{"Path":"$.MembershipDigest"}},{"column":"State","Properties":{"Path":"$.State"}}]';

.create-or-alter table TraceContentParts ingestion json mapping 'cao_v1' '[{"column":"Namespace","Properties":{"Path":"$.Namespace"}},{"column":"RunId","Properties":{"Path":"$.RunId"}},{"column":"RunAttempt","Properties":{"Path":"$.RunAttempt"}},{"column":"ProjectionId","Properties":{"Path":"$.ProjectionId"}},{"column":"RowDigest","Properties":{"Path":"$.RowDigest"}},{"column":"ContractVersion","Properties":{"Path":"$.ContractVersion"}},{"column":"Sequence","Properties":{"Path":"$.Sequence"}},{"column":"Part","Properties":{"Path":"$.Part"}},{"column":"Content","Properties":{"Path":"$.Content"}}]';
.alter table TraceContentParts policy streamingingestion enable;
.alter-merge table TraceContentParts policy retention softdelete = 7d recoverability = enabled;
.create-merge table TraceManifest (Namespace:string, RunId:string, RunAttempt:long, ProjectionId:string, RowDigest:string, ContractVersion:long, SourceRevision:long, Repository:string, ArtifactDigest:string, PolicyDigest:string, EventCount:long, PartCount:long, ContentDigest:string, State:string, Gaps:dynamic, CapturedAt:datetime);
.create-or-alter table TraceManifest ingestion json mapping 'cao_v1' '[{"column":"Namespace","Properties":{"Path":"$.Namespace"}},{"column":"RunId","Properties":{"Path":"$.RunId"}},{"column":"RunAttempt","Properties":{"Path":"$.RunAttempt"}},{"column":"ProjectionId","Properties":{"Path":"$.ProjectionId"}},{"column":"RowDigest","Properties":{"Path":"$.RowDigest"}},{"column":"ContractVersion","Properties":{"Path":"$.ContractVersion"}},{"column":"SourceRevision","Properties":{"Path":"$.SourceRevision"}},{"column":"Repository","Properties":{"Path":"$.Repository"}},{"column":"ArtifactDigest","Properties":{"Path":"$.ArtifactDigest"}},{"column":"PolicyDigest","Properties":{"Path":"$.PolicyDigest"}},{"column":"EventCount","Properties":{"Path":"$.EventCount"}},{"column":"PartCount","Properties":{"Path":"$.PartCount"}},{"column":"ContentDigest","Properties":{"Path":"$.ContentDigest"}},{"column":"State","Properties":{"Path":"$.State"}},{"column":"Gaps","Properties":{"Path":"$.Gaps"}},{"column":"CapturedAt","Properties":{"Path":"$.CapturedAt"}}]';

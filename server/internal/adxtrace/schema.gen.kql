.create-or-alter table TraceOutcomes ingestion json mapping 'cao_v1' '[{"column":"Namespace","Properties":{"Path":"$.Namespace"}},{"column":"RunId","Properties":{"Path":"$.RunId"}},{"column":"RunAttempt","Properties":{"Path":"$.RunAttempt"}},{"column":"ProjectionId","Properties":{"Path":"$.ProjectionId"}},{"column":"RowDigest","Properties":{"Path":"$.RowDigest"}},{"column":"ContractVersion","Properties":{"Path":"$.ContractVersion"}},{"column":"SourceRevision","Properties":{"Path":"$.SourceRevision"}},{"column":"CanonicalNamespace","Properties":{"Path":"$.CanonicalNamespace"}},{"column":"CanonicalRunId","Properties":{"Path":"$.CanonicalRunId"}},{"column":"Repository","Properties":{"Path":"$.Repository"}},{"column":"OutputId","Properties":{"Path":"$.OutputId"}},{"column":"OutputUrl","Properties":{"Path":"$.OutputUrl"}},{"column":"OutputType","Properties":{"Path":"$.OutputType"}},{"column":"AuditId","Properties":{"Path":"$.AuditId"}},{"column":"ProducingAttempt","Properties":{"Path":"$.ProducingAttempt"}},{"column":"Status","Properties":{"Path":"$.Status"}},{"column":"Signal","Properties":{"Path":"$.Signal"}},{"column":"ObjectState","Properties":{"Path":"$.ObjectState"}},{"column":"ObjectUpdatedAt","Properties":{"Path":"$.ObjectUpdatedAt"}},{"column":"ObservedAt","Properties":{"Path":"$.ObservedAt"}},{"column":"AcquisitionSource","Properties":{"Path":"$.AcquisitionSource"}},{"column":"Scope","Properties":{"Path":"$.Scope"}},{"column":"EvidenceState","Properties":{"Path":"$.EvidenceState"}},{"column":"LabelRuleVersion","Properties":{"Path":"$.LabelRuleVersion"}}]';

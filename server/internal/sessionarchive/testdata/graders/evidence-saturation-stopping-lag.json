      },
      {
        "field": "TraceId",
        "as": "d",
        "reducer": "count",
        "filter": {
          "predicates": [
            {
              "field": "Items",
              "state": "excluded"
            }
          ]
        }
      },
      {
        "field": "Index",
        "as": "k",
        "reducer": "count",
        "filter": {
          "predicates": [
            {
              "field": "Index",
              "gte": 0
            }
          ]
        }
      },
      {
        "field": "Index",
        "as": "lag",
        "reducer": "count",
        "filter": {
          "predicates": [
            {

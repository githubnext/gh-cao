{
  "name": "evidence-saturation-stopping-lag",
  "subject": "Recompute gh-aw evidence saturation stopping lag.",
  "queries": [
    {
      "name": "hits",
      "subject": "Event indexes.",
      "from": "archive-ir-events",
      "filter": {
        "predicates": [
          {
            "field": "Index",
            "gte": 0
          }
        ]
      },
      "aggregate": {
        "by": [
          "Namespace",
          "Repository",
          "RunId",
          "RunAttempt",
          "TraceId",
          "ProjectionId",
          "PolicyDigest",
          "Index"
        ],
        "values": [
          {
            "field": "Ordinal",
            "as": "hit",
            "reducer": "count"
          }
        ]
      }
    },
    {
      "name": "goals",
      "subject": "Objectives.",
      "from": "archive-objectives",
      "joins": [
        {
          "source": "hits",
          "type": "left",
          "on": [
            {
              "left": "SatisfiedAtEventIndex",
              "right": "Index"
            }
          ],
          "fields": [
            {
              "field": "hit"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "Namespace",
          "Repository",
          "RunId",
          "RunAttempt",
          "TraceId",
          "ProjectionId",
          "PolicyDigest"
        ],
        "values": [
          {
            "field": "Items",
            "as": "gn",
            "reducer": "max"
          },
          {
            "field": "TraceId",
            "as": "gx",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "Items",
                  "state": "excluded"
                }
              ]
            }
          },
          {
            "field": "Ordinal",
            "as": "gr",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "Kind",
                  "equals": "object"
                }
              ]
            }
          },
          {
            "field": "SatisfiedAtEventIndex",
            "as": "gs",
            "reducer": "count"
          },
          {
            "field": "Ordinal",
            "as": "gi",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "SatisfiedAtEventIndex",
                  "state": "invalid"
                }
              ]
            }
          },
          {
            "field": "hit",
            "as": "gh",
            "reducer": "count"
          },
          {
            "field": "SatisfiedAtEventIndex",
            "as": "at",
            "reducer": "max"
          }
        ]
      }
    }
  ],
  "from": "archive-ir-events",
  "joins": [
    {
      "source": "goals",
      "fields": [
        {
          "field": "gn"
        },
        {
          "field": "gx"
        },
        {
          "field": "gr"
        },
        {
          "field": "gs"
        },
        {
          "field": "gi"
        },
        {
          "field": "gh"
        },
        {
          "field": "at"
        }
      ]
    }
  ],
  "compute": [
    {
      "as": "late",
      "function": "gt",
      "args": [
        {
          "field": "Index"
        },
        {
          "field": "at"
        }
      ]
    }
  ],
  "aggregate": {
    "by": [
      "Namespace",
      "Repository",
      "RunId",
      "RunAttempt",
      "TraceId",
      "ProjectionId",
      "PolicyDigest"
    ],
    "values": [
      {
        "field": "Items",
        "as": "m",
        "reducer": "max"
      },
      {
        "field": "gn",
        "as": "n",
        "reducer": "max"
      },
      {
        "field": "gx",
        "as": "x",
        "reducer": "max"
      },
      {
        "field": "gr",

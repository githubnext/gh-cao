    },
    {
      "as": "reason",
      "function": "if",
      "args": [
        {
          "function": "gt",
          "args": [
            {
              "function": "sum",
              "args": [
                {
                  "field": "x"
                },
                {
                  "field": "d"
                }
              ]
            },
            {
              "value": 0

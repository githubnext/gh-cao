{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "SessionArchiveStatus.json",
    "type": "object",
    "properties": {
        "enabled": {
            "type": "boolean"
        },
        "stage": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "disabled"
                },
                {
                    "type": "string",
                    "const": "active"
                },
                {
                    "type": "string",
                    "const": "retrying"
                }
            ],
            "description": "Active is a running lifecycle, not proof that pending evidence is published or that Azure acceptance gates passed."
        },
        "archive": {
            "$ref": "#/$defs/SessionArchiveCounters"
        },
        "queryKinds": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Local archives advertise timeline, summary, and session-query. Hosted archives advertise session-query only after separate analytical-plan destination acceptance. No backend fallback is implied."
        },
        "analytical": {
            "$ref": "#/$defs/SessionArchiveCapabilities",
            "description": "Present only when session-query is supported. Generated scalar vocabulary and supported operators. ADX has a tighter 4096-row budget than DuckDB's 10000."
        }
    },
    "required": [
        "enabled",
        "stage"
    ],
    "$defs": {
        "SessionArchiveCounters": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "generation": {
                    "type": "string"
                },
                "activeTraces": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                },
                "stagedTraces": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                },
                "gaps": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647,
                    "description": "Durable source/admission gaps remain visible and reacquirable; zero does not imply complete upstream logs."
                },
                "archiveBytes": {
                    "type": "string"
                },
                "stagingBytes": {
                    "type": "string"
                }
            },
            "required": [
                "enabled",
                "generation",
                "activeTraces",
                "stagedTraces",
                "gaps",
                "archiveBytes",
                "stagingBytes"
            ]
        },
        "SessionArchiveCapabilities": {
            "type": "object",
            "properties": {
                "language-version": {
                    "type": "string",
                    "const": "0.2.0"
                },
                "source": {
                    "type": "string",
                    "const": "archive-events"
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/SessionArchiveColumn"
                    }
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/SessionArchiveSourceCapability"
                    },
                    "description": "Additional item sources supported by this backend. Omitted means archive-events only."
                },
                "predicates": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "reducers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "functions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "fieldStates": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "maxRows": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647,
                    "description": "Independent complete-result budget; an explicit limit must not exceed it."
                },
                "chaining": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647,
                    "description": "Maximum earlier definitions a session-query may chain through queries. Omitted means chained queries are rejected."
                }
            },
            "required": [
                "language-version",
                "source",
                "fields",
                "predicates",
                "reducers",
                "functions",
                "fieldStates",
                "maxRows"
            ]
        },
        "SessionArchiveColumn": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "string"
                        },
                        {
                            "type": "string",
                            "const": "integer"
                        },
                        {
                            "type": "string",
                            "const": "number"
                        },
                        {
                            "type": "string",
                            "const": "boolean"
                        }
                    ]
                }
            },
            "required": [
                "name",
                "type"
            ]
        },
        "SessionArchiveSourceCapability": {
            "type": "object",
            "properties": {
                "name": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "archive-objectives"
                        },
                        {
                            "type": "string",
                            "const": "archive-actions"
                        },
                        {
                            "type": "string",
                            "const": "archive-states"
                        }
                    ]
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/SessionArchiveColumn"
                    }
                }
            },
            "required": [
                "name",
                "fields"
            ]
        }
    }
}
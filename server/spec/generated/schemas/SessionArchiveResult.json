{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "SessionArchiveResult.json",
    "type": "object",
    "properties": {
        "generation": {
            "type": "string"
        },
        "kind": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "timeline"
                },
                {
                    "type": "string",
                    "const": "summary"
                },
                {
                    "type": "string",
                    "const": "session-query"
                }
            ]
        },
        "events": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/Event"
            }
        },
        "summary": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/SessionArchiveSummary"
            }
        },
        "columns": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/SessionArchiveColumn"
            }
        },
        "rows": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/RecordUnknown"
            },
            "description": "Present even for an empty analytical result. Integer values are serialized without float conversion."
        },
        "metadata": {
            "$ref": "#/$defs/SessionArchiveQueryMetadata"
        }
    },
    "required": [
        "generation",
        "kind"
    ],
    "description": "One authorized pinned generation. Approved payload JSON, explicit nulls, sequence, identity, omissions and provenance follow the shared trace contract, not another HTTP-only evidence model.",
    "$defs": {
        "Event": {
            "type": "object",
            "properties": {
                "Namespace": {
                    "type": "string"
                },
                "Repository": {
                    "type": "string"
                },
                "RunId": {
                    "type": "string",
                    "description": "Exact GitHub execution identity; not a harness or enrollment attempt."
                },
                "RunAttempt": {
                    "type": "string"
                },
                "TraceId": {
                    "type": "string"
                },
                "ProjectionId": {
                    "type": "string"
                },
                "ContractVersion": {
                    "type": "number",
                    "const": 2
                },
                "EvidenceVersion": {
                    "type": "string",
                    "description": "Shared approval/preservation transformation, independently versioned."
                },
                "Sequence": {
                    "type": "string"
                },
                "Type": {
                    "type": "string"
                },
                "ContentDigest": {
                    "type": "string"
                },
                "CompletionDay": {
                    "type": "string",
                    "description": "Empty means undated, never a fabricated source clock."
                },
                "ArtifactDigest": {
                    "type": "string"
                },
                "PolicyDigest": {
                    "type": "string"
                },
                "Gaps": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "CapturedAt": {
                    "type": "string"
                },
                "PresentFields": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Generated source binding names, including structured families. Not inferred source state."
                },
                "NullFields": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "InvalidFields": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "OmissionReasons": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Bounded known-field/family reasons; contains no excluded values."
                },
                "EventId": {
                    "type": "string",
                    "description": "Strings use empty physical values plus state metadata, also on ADX."
                },
                "ParentId": {
                    "type": "string"
                },
                "Timestamp": {
                    "type": "string"
                },
                "Component": {
                    "type": "string"
                },
                "Phase": {
                    "type": "string"
                },
                "ProvenancePath": {
                    "type": "string"
                },
                "ProvenanceIndex": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "ProvenanceTimestampMs": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "ProvenanceAttemptId": {
                    "type": "string"
                },
                "ProvenanceStartupAttemptId": {
                    "type": "string"
                },
                "SessionId": {
                    "type": "string"
                },
                "AgentId": {
                    "type": "string"
                },
                "ToolCallId": {
                    "type": "string"
                },
                "ToolName": {
                    "type": "string"
                },
                "Success": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "Status": {
                    "type": "string"
                },
                "IsError": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "Method": {
                    "type": "string"
                },
                "ServerName": {
                    "type": "string"
                },
                "RpcIdString": {
                    "type": "string"
                },
                "RpcIdNumber": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "RequestIdString": {
                    "type": "string"
                },
                "RequestIdNumber": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "InputTokens": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "OutputTokens": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "DurationMs": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "DataEvent": {
                    "type": "string"
                },
                "Message": {
                    "type": "string"
                },
                "Layer": {
                    "type": "string"
                },
                "DataAttempt": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "DataAttemptId": {
                    "type": "string"
                },
                "DataStartupAttemptId": {
                    "type": "string"
                },
                "Strategy": {
                    "type": "string"
                },
                "StartedAt": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "DataType": {
                    "type": "string"
                },
                "ProducerVersion": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "ProducerVersionString": {
                    "type": "string"
                },
                "PayloadJSON": {
                    "type": "string",
                    "description": "Full approved event as UTF-8 JSON; absent and explicit null remain distinct."
                }
            },
            "required": [
                "Namespace",
                "Repository",
                "RunId",
                "RunAttempt",
                "TraceId",
                "ProjectionId",
                "ContractVersion",
                "EvidenceVersion",
                "Sequence",
                "Type",
                "ContentDigest",
                "CompletionDay",
                "ArtifactDigest",
                "PolicyDigest",
                "Gaps",
                "CapturedAt",
                "PresentFields",
                "NullFields",
                "InvalidFields",
                "OmissionReasons",
                "EventId",
                "ParentId",
                "Timestamp",
                "Component",
                "Phase",
                "ProvenancePath",
                "ProvenanceAttemptId",
                "ProvenanceStartupAttemptId",
                "SessionId",
                "AgentId",
                "ToolCallId",
                "ToolName",
                "Status",
                "Method",
                "ServerName",
                "RpcIdString",
                "RequestIdString",
                "DataEvent",
                "Message",
                "Layer",
                "DataAttemptId",
                "DataStartupAttemptId",
                "Strategy",
                "DataType",
                "ProducerVersionString",
                "PayloadJSON"
            ]
        },
        "SessionArchiveSummary": {
            "type": "object",
            "properties": {
                "repository": {
                    "type": "string"
                },
                "runId": {
                    "type": "string"
                },
                "attempt": {
                    "type": "string"
                },
                "projectionId": {
                    "type": "string"
                },
                "events": {
                    "type": "string"
                }
            },
            "required": [
                "repository",
                "runId",
                "attempt",
                "projectionId",
                "events"
            ]
        },
        "SessionArchiveColumn": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "string"
                        },
                        {
                            "type": "string",
                            "const": "integer"
                        },
                        {
                            "type": "string",
                            "const": "number"
                        },
                        {
                            "type": "string",
                            "const": "boolean"
                        }
                    ]
                }
            },
            "required": [
                "name",
                "type"
            ]
        },
        "RecordUnknown": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {}
        },
        "SessionArchiveQueryMetadata": {
            "type": "object",
            "properties": {
                "limited": {
                    "type": "boolean",
                    "description": "Whether the explicit analytical limit omitted matching output rows. Never indicates a silently exceeded resource budget."
                },
                "upstreamCoverage": {
                    "type": "string",
                    "const": "unknown",
                    "description": "Always unknown: archive coverage is not proof of complete upstream history."
                },
                "admissionGaps": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647,
                    "description": "Repository-scoped durable acquisition/admission gaps at the pinned generation's assessment."
                },
                "tracesWithGaps": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647,
                    "description": "Retained active traces with recorded omissions, before user filtering; distinct from admission gaps."
                },
                "queryDigest": {
                    "type": "string"
                },
                "implementation": {
                    "type": "string"
                },
                "language-version": {
                    "type": "string",
                    "const": "0.2.0"
                }
            },
            "required": [
                "limited",
                "upstreamCoverage",
                "admissionGaps",
                "tracesWithGaps",
                "queryDigest",
                "implementation",
                "language-version"
            ]
        }
    }
}
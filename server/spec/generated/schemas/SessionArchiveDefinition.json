{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "SessionArchiveDefinition.json",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
        },
        "objective": {
            "type": "string"
        },
        "acceptance": {
            "type": "string"
        },
        "queries": {
            "type": "array",
            "items": {
                "$ref": "SessionArchiveDefinition.json"
            },
            "maxItems": 2,
            "description": "Query chaining (Dashboard Language DLS-QUERY-017): earlier definitions in the same request, evaluated in order before this one. The first reads an archive source, each later one reads its immediate predecessor by name, and this definition reads the last, so no stage is unused. Earlier definitions must aggregate with every trace and projection identity field (Namespace, Repository, RunId, RunAttempt, TraceId, ProjectionId) in aggregate.by, and must not declare queries, select, order-by or limit; their output is their groups, aggregates and computations. Names are unique and never shadow a source. Rejected unless status advertises analytical.chaining at least this length."
        },
        "from": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "One of archive-events, archive-objectives, archive-actions or archive-states, or the name of the last earlier definition in queries. archive-events is the shared event source. The item sources flatten the last agent-phase trajectory.ir collection of each complete active trace at query time, with one anchor row per trace; local DuckDB and hosted KQL both lower them, and they are rejected unless status advertises them in analytical.sources. Any other value names the last earlier definition in queries; an aggregate over it must keep complete trace binding in aggregate.by, and field-state predicates and first are unavailable there."
        },
        "filter": {
            "type": "object",
            "properties": {
                "predicates": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/SessionArchivePredicate"
                    },
                    "minItems": 1,
                    "maxItems": 64
                }
            },
            "required": [
                "predicates"
            ]
        },
        "aggregate": {
            "type": "object",
            "properties": {
                "by": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "maxItems": 16
                },
                "values": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "field": {
                                "type": "string"
                            },
                            "as": {
                                "type": "string"
                            },
                            "reducer": {
                                "anyOf": [
                                    {
                                        "type": "string",
                                        "const": "count"
                                    },
                                    {
                                        "type": "string",
                                        "const": "distinct-count"
                                    },
                                    {
                                        "type": "string",
                                        "const": "sum"
                                    },
                                    {
                                        "type": "string",
                                        "const": "max"
                                    },
                                    {
                                        "type": "string",
                                        "const": "first"
                                    }
                                ]
                            },
                            "filter": {
                                "type": "object",
                                "properties": {
                                    "predicates": {
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/$defs/SessionArchivePredicate"
                                        },
                                        "minItems": 1,
                                        "maxItems": 64
                                    }
                                },
                                "required": [
                                    "predicates"
                                ]
                            },
                            "orderBy": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/$defs/OrderField"
                                },
                                "description": "first requires Sequence ascending and complete trace binding in aggregate.by. Sum of real observations also requires this order, preserving sequential IEEE arithmetic. Over an earlier definition, a real sum instead orders ascending by exactly the earlier aggregate.by fields absent from this aggregate.by, in their declared order."
                            }
                        },
                        "required": [
                            "field",
                            "as",
                            "reducer"
                        ]
                    },
                    "minItems": 1,
                    "maxItems": 16
                }
            },
            "required": [
                "values"
            ]
        },
        "postAggregate": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "as": {
                        "type": "string"
                    },
                    "function": {
                        "anyOf": [
                            {
                                "type": "string",
                                "const": "if"
                            },
                            {
                                "type": "string",
                                "const": "equals"
                            },
                            {
                                "type": "string",
                                "const": "gt"
                            },
                            {
                                "type": "string",
                                "const": "lte"
                            },
                            {
                                "type": "string",
                                "const": "sum"
                            },
                            {
                                "type": "string",
                                "const": "difference"
                            },
                            {
                                "type": "string",
                                "const": "product"
                            },
                            {
                                "type": "string",
                                "const": "quotient"
                            },
                            {
                                "type": "string",
                                "const": "coalesce"
                            },
                            {
                                "type": "string",
                                "const": "is-null"
                            },
                            {
                                "type": "string",
                                "const": "and"
                            }
                        ]
                    },
                    "args": {
                        "type": "array",
                        "items": {
                            "$ref": "#/$defs/SessionArchiveExpression"
                        },
                        "maxItems": 3
                    }
                },
                "required": [
                    "as",
                    "function",
                    "args"
                ]
            },
            "maxItems": 32,
            "description": "Explicit bounded phase after aggregation, before selection/order/limit. Computations can reference groups, aggregates and preceding computations, never source rows."
        },
        "select": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/SelectedField"
            },
            "minItems": 1,
            "maxItems": 32,
            "description": "Required for non-aggregate queries. Only generated scalar event columns are allowed; PayloadJSON and Gaps are not query fields."
        },
        "orderBy": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/OrderField"
            },
            "maxItems": 16
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "description": "Intentional top-N selection after aggregation, projection and deterministic ordering. Omitted means the complete result must fit the independent response budget."
        }
    },
    "required": [
        "name",
        "subject",
        "from"
    ],
    "description": "Shared DuckDB/ADX analytical profile of Dashboard Language, not a full dashboard document. Unknown keys and fields fail before execution. Predicates are conjunctive, with exactly one of equals, in, or a gte/lt range; boolean ranges are forbidden. String comparisons are exact and case-sensitive; ordering is typed, with UTF-8 lexical string order and empty strings last. Counts exclude empty strings and null scalars, but retain false and zero; distinct-count is exact, never approximate.",
    "$defs": {
        "SessionArchivePredicate": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "equals": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "string"
                        },
                        {
                            "type": "number"
                        },
                        {
                            "type": "boolean"
                        }
                    ]
                },
                "in": {
                    "type": "array",
                    "items": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "string"
                            },
                            {
                                "type": "number"
                            },
                            {
                                "type": "boolean"
                            }
                        ]
                    },
                    "minItems": 1,
                    "maxItems": 32
                },
                "gte": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "string"
                        },
                        {
                            "type": "number"
                        }
                    ]
                },
                "lt": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "string"
                        },
                        {
                            "type": "number"
                        }
                    ]
                },
                "state": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "present"
                        },
                        {
                            "type": "string",
                            "const": "absent"
                        },
                        {
                            "type": "string",
                            "const": "null"
                        },
                        {
                            "type": "string",
                            "const": "invalid"
                        },
                        {
                            "type": "string",
                            "const": "excluded"
                        },
                        {
                            "type": "string",
                            "const": "redacted"
                        },
                        {
                            "type": "string",
                            "const": "valid"
                        }
                    ],
                    "description": "State of a declared promoted field, inspected through generated evidence metadata only. Exclusive with comparison operands."
                }
            },
            "required": [
                "field"
            ]
        },
        "OrderField": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "direction": {
                    "type": "string"
                }
            },
            "required": [
                "field"
            ]
        },
        "SessionArchiveExpression": {
            "anyOf": [
                {
                    "$ref": "#/$defs/SessionArchiveFieldArgument"
                },
                {
                    "$ref": "#/$defs/SessionArchiveValueArgument"
                },
                {
                    "$ref": "#/$defs/SessionArchiveNullArgument"
                },
                {
                    "$ref": "#/$defs/SessionArchiveFunctionArgument"
                }
            ]
        },
        "SelectedField": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "as": {
                    "type": "string"
                }
            },
            "required": [
                "field"
            ]
        },
        "SessionArchiveFieldArgument": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                }
            },
            "required": [
                "field"
            ]
        },
        "SessionArchiveValueArgument": {
            "type": "object",
            "properties": {
                "value": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "string"
                        },
                        {
                            "type": "number"
                        },
                        {
                            "type": "boolean"
                        }
                    ]
                },
                "type": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "string"
                        },
                        {
                            "type": "string",
                            "const": "integer"
                        },
                        {
                            "type": "string",
                            "const": "number"
                        },
                        {
                            "type": "string",
                            "const": "boolean"
                        }
                    ]
                }
            },
            "required": [
                "value"
            ]
        },
        "SessionArchiveNullArgument": {
            "type": "object",
            "properties": {
                "value": {
                    "type": "null"
                },
                "type": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "integer"
                        },
                        {
                            "type": "string",
                            "const": "number"
                        }
                    ]
                }
            },
            "required": [
                "value",
                "type"
            ],
            "description": "Null is allowed only as an explicitly typed numeric computation literal."
        },
        "SessionArchiveFunctionArgument": {
            "type": "object",
            "properties": {
                "function": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "if"
                        },
                        {
                            "type": "string",
                            "const": "equals"
                        },
                        {
                            "type": "string",
                            "const": "gt"
                        },
                        {
                            "type": "string",
                            "const": "lte"
                        },
                        {
                            "type": "string",
                            "const": "sum"
                        },
                        {
                            "type": "string",
                            "const": "difference"
                        },
                        {
                            "type": "string",
                            "const": "product"
                        },
                        {
                            "type": "string",
                            "const": "quotient"
                        },
                        {
                            "type": "string",
                            "const": "coalesce"
                        },
                        {
                            "type": "string",
                            "const": "is-null"
                        },
                        {
                            "type": "string",
                            "const": "and"
                        }
                    ]
                },
                "args": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/SessionArchiveExpression"
                    },
                    "maxItems": 3
                }
            },
            "required": [
                "function",
                "args"
            ]
        }
    }
}
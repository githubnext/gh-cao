{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "SessionArchiveDefinition.json",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
        },
        "objective": {
            "type": "string"
        },
        "acceptance": {
            "type": "string"
        },
        "from": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "archive-events"
                },
                {
                    "type": "string",
                    "const": "archive-objectives"
                },
                {
                    "type": "string",
                    "const": "archive-actions"
                },
                {
                    "type": "string",
                    "const": "archive-states"
                }
            ],
            "description": "archive-events is the shared event source. The item sources flatten the last agent-phase trajectory.ir collection of each complete active trace at query time, with one anchor row per trace; they are local DuckDB only until a hosted lowering is accepted, and are rejected unless status advertises them in analytical.sources."
        },
        "filter": {
            "type": "object",
            "properties": {
                "predicates": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/SessionArchivePredicate"
                    },
                    "minItems": 1,
                    "maxItems": 64
                }
            },
            "required": [
                "predicates"
            ]
        },
        "aggregate": {
            "type": "object",
            "properties": {
                "by": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "maxItems": 16
                },
                "values": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "field": {
                                "type": "string"
                            },
                            "as": {
                                "type": "string"
                            },
                            "reducer": {
                                "anyOf": [
                                    {
                                        "type": "string",
                                        "const": "count"
                                    },
                                    {
                                        "type": "string",
                                        "const": "distinct-count"
                                    },
                                    {
                                        "type": "string",
                                        "const": "sum"
                                    },
                                    {
                                        "type": "string",
                                        "const": "max"
                                    },
                                    {
                                        "type": "string",
                                        "const": "first"
                                    }
                                ]
                            },
                            "filter": {
                                "type": "object",
                                "properties": {
                                    "predicates": {
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/$defs/SessionArchivePredicate"
                                        },
                                        "minItems": 1,
                                        "maxItems": 64
                                    }
                                },
                                "required": [
                                    "predicates"
                                ]
                            },
                            "orderBy": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/$defs/OrderField"
                                },
                                "description": "first requires Sequence ascending and complete trace binding in aggregate.by. Sum of real observations also requires this order, preserving sequential IEEE arithmetic."
                            }
                        },
                        "required": [
                            "field",
                            "as",
                            "reducer"
                        ]
                    },
                    "minItems": 1,
                    "maxItems": 16
                }
            },
            "required": [
                "values"
            ]
        },
        "postAggregate": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "as": {
                        "type": "string"
                    },
                    "function": {
                        "anyOf": [
                            {
                                "type": "string",
                                "const": "if"
                            },
                            {
                                "type": "string",
                                "const": "equals"
                            },
                            {
                                "type": "string",
                                "const": "gt"
                            },
                            {
                                "type": "string",
                                "const": "lte"
                            },
                            {
                                "type": "string",
                                "const": "sum"
                            },
                            {
                                "type": "string",
                                "const": "difference"
                            },
                            {
                                "type": "string",
                                "const": "product"
                            },
                            {
                                "type": "string",
                                "const": "quotient"
                            },
                            {
                                "type": "string",
                                "const": "coalesce"
                            },
                            {
                                "type": "string",
                                "const": "is-null"
                            },
                            {
                                "type": "string",
                                "const": "and"
                            }
                        ]
                    },
                    "args": {
                        "type": "array",
                        "items": {
                            "$ref": "#/$defs/SessionArchiveExpression"
                        },
                        "maxItems": 3
                    }
                },
                "required": [
                    "as",
                    "function",
                    "args"
                ]
            },
            "maxItems": 32,
            "description": "Explicit bounded phase after aggregation, before selection/order/limit. Computations can reference groups, aggregates and preceding computations, never source rows."
        },
        "select": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/SelectedField"
            },
            "minItems": 1,
            "maxItems": 32,
            "description": "Required for non-aggregate queries. Only generated scalar event columns are allowed; PayloadJSON and Gaps are not query fields."
        },
        "orderBy": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/OrderField"
            },
            "maxItems": 16
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "description": "Intentional top-N selection after aggregation, projection and deterministic ordering. Omitted means the complete result must fit the independent response budget."
        }
    },
    "required": [
        "name",
        "subject",
        "from"
    ],
    "description": "Shared DuckDB/ADX analytical profile of Dashboard Language, not a full dashboard document. Unknown keys and fields fail before execution. Predicates are conjunctive, with exactly one of equals, in, or a gte/lt range; boolean ranges are forbidden. String comparisons are exact and case-sensitive; ordering is typed, with UTF-8 lexical string order and empty strings last. Counts exclude empty strings and null scalars, but retain false and zero; distinct-count is exact, never approximate.",
    "$defs": {
        "SessionArchivePredicate": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "equals": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "string"
                        },
                        {
                            "type": "number"
                        },
                        {
                            "type": "boolean"
                        }
                    ]
                },
                "in": {
                    "type": "array",
                    "items": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "string"
                            },
                            {
                                "type": "number"
                            },
                            {
                                "type": "boolean"
                            }
                        ]
                    },
                    "minItems": 1,
                    "maxItems": 32
                },
                "gte": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "string"
                        },
                        {
                            "type": "number"
                        }
                    ]
                },
                "lt": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "string"
                        },
                        {
                            "type": "number"
                        }
                    ]
                },
                "state": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "present"
                        },
                        {
                            "type": "string",
                            "const": "absent"
                        },
                        {
                            "type": "string",
                            "const": "null"
                        },
                        {
                            "type": "string",
                            "const": "invalid"
                        },
                        {
                            "type": "string",
                            "const": "excluded"
                        },
                        {
                            "type": "string",
                            "const": "redacted"
                        },
                        {
                            "type": "string",
                            "const": "valid"
                        }
                    ],
                    "description": "State of a declared promoted field, inspected through generated evidence metadata only. Exclusive with comparison operands."
                }
            },
            "required": [
                "field"
            ]
        },
        "OrderField": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "direction": {
                    "type": "string"
                }
            },
            "required": [
                "field"
            ]
        },
        "SessionArchiveExpression": {
            "anyOf": [
                {
                    "$ref": "#/$defs/SessionArchiveFieldArgument"
                },
                {
                    "$ref": "#/$defs/SessionArchiveValueArgument"
                },
                {
                    "$ref": "#/$defs/SessionArchiveNullArgument"
                },
                {
                    "$ref": "#/$defs/SessionArchiveFunctionArgument"
                }
            ]
        },
        "SelectedField": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "as": {
                    "type": "string"
                }
            },
            "required": [
                "field"
            ]
        },
        "SessionArchiveFieldArgument": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                }
            },
            "required": [
                "field"
            ]
        },
        "SessionArchiveValueArgument": {
            "type": "object",
            "properties": {
                "value": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "string"
                        },
                        {
                            "type": "number"
                        },
                        {
                            "type": "boolean"
                        }
                    ]
                },
                "type": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "string"
                        },
                        {
                            "type": "string",
                            "const": "integer"
                        },
                        {
                            "type": "string",
                            "const": "number"
                        },
                        {
                            "type": "string",
                            "const": "boolean"
                        }
                    ]
                }
            },
            "required": [
                "value"
            ]
        },
        "SessionArchiveNullArgument": {
            "type": "object",
            "properties": {
                "value": {
                    "type": "null"
                },
                "type": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "integer"
                        },
                        {
                            "type": "string",
                            "const": "number"
                        }
                    ]
                }
            },
            "required": [
                "value",
                "type"
            ],
            "description": "Null is allowed only as an explicitly typed numeric computation literal."
        },
        "SessionArchiveFunctionArgument": {
            "type": "object",
            "properties": {
                "function": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "if"
                        },
                        {
                            "type": "string",
                            "const": "equals"
                        },
                        {
                            "type": "string",
                            "const": "gt"
                        },
                        {
                            "type": "string",
                            "const": "lte"
                        },
                        {
                            "type": "string",
                            "const": "sum"
                        },
                        {
                            "type": "string",
                            "const": "difference"
                        },
                        {
                            "type": "string",
                            "const": "product"
                        },
                        {
                            "type": "string",
                            "const": "quotient"
                        },
                        {
                            "type": "string",
                            "const": "coalesce"
                        },
                        {
                            "type": "string",
                            "const": "is-null"
                        },
                        {
                            "type": "string",
                            "const": "and"
                        }
                    ]
                },
                "args": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/SessionArchiveExpression"
                    },
                    "maxItems": 3
                }
            },
            "required": [
                "function",
                "args"
            ]
        }
    }
}
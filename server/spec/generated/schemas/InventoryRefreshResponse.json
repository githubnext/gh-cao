{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "InventoryRefreshResponse.json",
    "type": "object",
    "properties": {
        "requested": {
            "type": "boolean",
            "const": true
        },
        "mode": {
            "anyOf": [
                {
                    "type": "string",
                    "const": "inventory"
                },
                {
                    "type": "string",
                    "const": "local-collection"
                }
            ],
            "description": "Native queues refresh only current enrolled inventory; the local CLI adapter requests its existing bounded collection pass."
        },
        "queued": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647,
            "description": "Native tasks admitted now, excluding coalesced requests. Absent for the local adapter."
        }
    },
    "required": [
        "requested",
        "mode"
    ]
}
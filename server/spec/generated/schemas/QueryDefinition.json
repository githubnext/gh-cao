{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "QueryDefinition.json",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "from": {
            "type": "string"
        },
        "union": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "joins": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/Join"
            }
        },
        "filter": {
            "$ref": "#/$defs/Filter"
        },
        "compute": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/ComputedField"
            }
        },
        "aggregate": {
            "type": "object",
            "properties": {
                "by": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "values": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/AggregateValue"
                    }
                }
            },
            "required": [
                "values"
            ]
        },
        "temporalSeries": {
            "$ref": "#/$defs/TemporalSeries"
        },
        "predict": {
            "type": "array",
            "items": {}
        },
        "window": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/WindowField"
            },
            "minItems": 1,
            "maxItems": 8
        },
        "select": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/SelectedField"
            }
        },
        "orderBy": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/OrderField"
            }
        },
        "page": {
            "$ref": "#/$defs/QueryPageBoundary"
        },
        "limit": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
        },
        "facet": {
            "$ref": "#/$defs/Facet"
        },
        "stores": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "name",
        "from"
    ],
    "description": "A Dashboard Language query definition. See dashboard/site/dashboard.json for the language vocabulary.",
    "$defs": {
        "Join": {
            "type": "object",
            "properties": {
                "source": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "description": "inner and left require unique right keys; inner-many explicitly expands all matching rows within query budgets. Missing or blank keys never match."
                },
                "on": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "left": {
                                "type": "string"
                            },
                            "right": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "left",
                            "right"
                        ]
                    }
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/SelectedField"
                    }
                }
            },
            "required": [
                "source",
                "on",
                "fields"
            ]
        },
        "Filter": {
            "type": "object",
            "properties": {
                "predicates": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Predicate"
                    }
                },
                "search": {
                    "type": "object",
                    "properties": {
                        "fields": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "query": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "fields",
                        "query"
                    ]
                }
            }
        },
        "ComputedField": {
            "type": "object",
            "properties": {
                "as": {
                    "type": "string"
                },
                "function": {
                    "type": "string"
                },
                "args": {
                    "type": "array",
                    "items": {
                        "anyOf": [
                            {
                                "type": "object",
                                "properties": {
                                    "field": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "field"
                                ]
                            },
                            {
                                "type": "object",
                                "properties": {
                                    "value": {}
                                },
                                "required": [
                                    "value"
                                ]
                            },
                            {
                                "type": "object",
                                "properties": {
                                    "context": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "context"
                                ]
                            }
                        ]
                    }
                }
            },
            "required": [
                "as",
                "function",
                "args"
            ]
        },
        "AggregateValue": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "as": {
                    "type": "string"
                },
                "reducer": {
                    "type": "string",
                    "description": "Includes median, p75, p90 and p95: continuous quantiles over known finite numeric values."
                },
                "filter": {
                    "$ref": "#/$defs/Filter"
                }
            },
            "required": [
                "field",
                "as",
                "reducer"
            ]
        },
        "TemporalSeries": {
            "type": "object",
            "properties": {
                "time": {
                    "type": "string"
                },
                "series": {
                    "type": "string"
                },
                "shape": {
                    "type": "string"
                },
                "carry": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "measures": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "field": {
                                "type": "string"
                            },
                            "key": {
                                "type": "string"
                            },
                            "kind": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "field",
                            "kind"
                        ]
                    }
                },
                "maps": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "field": {
                                "type": "string"
                            },
                            "definitions": {
                                "type": "string"
                            },
                            "group": {
                                "type": "string"
                            },
                            "kind": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "field",
                            "kind"
                        ]
                    }
                },
                "trend": {
                    "$ref": "#/$defs/TemporalTrend"
                }
            },
            "required": [
                "time",
                "series"
            ]
        },
        "WindowField": {
            "type": "object",
            "properties": {
                "operation": {
                    "type": "string"
                },
                "field": {
                    "type": "string"
                },
                "as": {
                    "type": "string"
                },
                "order-by": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/OrderField"
                    }
                },
                "groupby": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "frame": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                },
                "reducer": {
                    "type": "string"
                },
                "alignment": {
                    "type": "string"
                },
                "mode": {
                    "type": "string"
                },
                "time-field": {
                    "type": "string"
                },
                "unit": {
                    "type": "string"
                }
            },
            "required": [
                "operation",
                "field",
                "as",
                "order-by"
            ],
            "description": "An ordered rolling, change, previous-value or row-number operation, evaluated after aggregation and before temporal-series projection. previous preserves scalar type; row-number is one-based."
        },
        "SelectedField": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "as": {
                    "type": "string"
                }
            },
            "required": [
                "field"
            ]
        },
        "OrderField": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "direction": {
                    "type": "string"
                }
            },
            "required": [
                "field"
            ]
        },
        "QueryPageBoundary": {
            "type": "object",
            "properties": {
                "keys": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 4
                },
                "revision": {
                    "type": "string",
                    "const": "workflow-subjects"
                },
                "comparator": {
                    "type": "string",
                    "const": "utf8-bytewise-v1"
                }
            },
            "required": [
                "keys",
                "revision",
                "comparator"
            ]
        },
        "Facet": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "row": {
                    "type": "string"
                },
                "column": {
                    "type": "string"
                },
                "as": {
                    "type": "string"
                }
            },
            "required": [
                "as"
            ],
            "description": "Terminal projection of processed rows into at most 64 chart panels. Declare field alone, or row and/or column; as names each panel's ordered row sequence."
        },
        "Predicate": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "equals": {},
                "in": {
                    "type": "array",
                    "items": {}
                },
                "includes": {
                    "type": "string"
                },
                "gte": {},
                "lt": {},
                "optional": {
                    "type": "boolean"
                }
            },
            "required": [
                "field"
            ]
        },
        "TemporalTrend": {
            "type": "object",
            "properties": {
                "direction": {
                    "type": "string"
                }
            },
            "required": [
                "direction"
            ]
        }
    }
}
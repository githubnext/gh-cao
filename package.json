{
  "name": "central-agentic-ops",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "cao": "activity/cao.mjs"
  },
  "scripts": {
    "postinstall": "node dashboard/site/scripts/prepare-terminal.mjs",
    "install:gh-aw": "GH_AW_VERSION=$(node .github/workflows/shared/control.mjs compiler-version .github/workflows/cao.json) && curl -sL https://raw.githubusercontent.com/github/gh-aw/main/install-gh-aw.sh | bash -s -- \"$GH_AW_VERSION\"",
    "dashboard:local": "CAO_MARKETPLACE_POLICY_PATH=\"${CAO_MARKETPLACE_POLICY_PATH:-$PWD/.github/workflows/cao.json}\" go -C server run ./cmd/cao-dashboard serve",
    "predashboard:local": "npm --prefix dashboard/site run build -- dist ../../.github/workflows/cao.json",
    "dashboard:pages": "go -C server run ./cmd/cao-dashboard serve-pages",
    "dashboard:pages:build": "node scripts/simulate-dashboard-pages.mjs",
    "dashboard:server:build": "npm run dashboard:server:spec:check && npm --prefix dashboard/site run build -- dist ../../.github/workflows/cao.json",
    "dashboard:server:redis-up": "docker-compose -f server/docker-compose.yml up -d redis",
    "dashboard:server:postgres-up": "docker-compose -f server/docker-compose.yml up -d postgres",
    "dashboard:server:otel-up": "docker-compose -f server/otel-compose.yml up -d",
    "dashboard:server:redis-down": "docker-compose -f server/docker-compose.yml down",
    "dashboard:server:setup:macos": "bash scripts/setup-dashboard-server-macos.sh",
    "dashboard:server:ingest": "go -C server run ./cmd/cao-dashboard ingest",
    "dashboard:server:serve": "CAO_MARKETPLACE_POLICY_PATH=\"${CAO_MARKETPLACE_POLICY_PATH:-$PWD/.github/workflows/cao.json}\" go -C server run ./cmd/cao-dashboard serve",
    "dashboard:server:otel-smoke": "go -C server run ./cmd/cao-dashboard otel-smoke",
    "dashboard:server:lint": "cd server && golangci-lint fmt --diff && golangci-lint run ./...",
    "dashboard:server:test": "go -C server test -p 1 ./...",
    "test:integration:dashboard-backfill": "bash scripts/test-dashboard-backfill.sh",
    "test:integration:actions-simulator": "go -C server test -race ./internal/simulator ./internal/admission ./internal/webhookgateway ./cmd/cao-webhook-gateway -run '^(TestLocalActions|TestSpecLocalHost|TestGatewayAPI|TestIssueServiceSimulator($|HTTP|GatewaySQLite)|TestGitHubSimulator(Gateway|Discovery)SQLite)' -count=1 -timeout=2m -v",
    "test:integration:issue-services": "go -C server test -race ./internal/simulator ./internal/webhookgateway -run '^TestIssueServiceSimulator($|HTTP|GatewaySQLite)' -count=1 -timeout=2m -v",
    "test:integration:actions-runtime": "node --test --test-concurrency=1 tests/integration/actions-runtime.test.mjs tests/integration/activity-actions-runtime.test.mjs",
    "test:integration:bootstrap": "CAO_BOOTSTRAP_INTEGRATION=1 go -C server test -race ./internal/simulator -run '^(TestCAOBootstrapIntegration|TestBootstrap)' -count=1 -timeout=10m -v",
    "test:integration:setup": "CAO_SETUP_INTEGRATION=1 go -C server test -race ./internal/simulator -run '^(TestCAO(Setup|HostedCLISetup)Integration|TestSetup)' -count=1 -timeout=10m -v",
    "test:integration:setup-azure": "CAO_SETUP_AZURE_INTEGRATION=1 GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off GOVCS='*:off' go -C server test -race ./internal/simulator -run '^(TestCAOSetupAzureIntegration|TestSetupAzure|TestLocalTransport)' -count=1 -timeout=10m -v",
    "test:integration:azure-install-journey": "CAO_SETUP_AZURE_INTEGRATION=1 GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off GOVCS='*:off' go -C server test -race ./internal/simulator -run '^TestCAOAzureInstallJourneyIntegration$' -count=1 -timeout=10m -v",
    "test:integration:actions-simulator-postgres": "CAO_ACTIONS_SIMULATOR_POSTGRES=1 go -C server test -race ./internal/admission ./internal/webhookgateway -run '^(TestLocalActionsPostgresIntegration|TestIssueServiceSimulatorGatewayPostgres|TestGitHubSimulator(Gateway|Discovery)Postgres)$' -count=1 -timeout=2m -v",
    "test:stress:dashboard-backfill": "CAO_BACKFILL_STRESS=1 bash scripts/test-dashboard-backfill.sh",
    "test:stress:monthly-budget": "CAO_MONTHLY_BUDGET_STRESS=1 go -C server test ./internal/postgresx -run '^TestMonthlyBudgetStress$' -count=1 -timeout=40m -v",
    "test:stress:cao": "CAO_FLEET_STRESS=1 go -C server test ./internal/webhookgateway -run '^TestGitHubSimulatorFleetStress$' -count=1 -timeout=60m -v",
    "test:stress:company": "node scripts/company-stress.mjs",
    "dashboard:server:spec": "npm --prefix server/spec run generate",
    "dashboard:server:spec:check": "npm --prefix server/spec run check",
    "dashboard:local:mobile": "DASHBOARD_DATA_URL=https://githubnext.github.io/gh-cao/cao/payload-hashes.json MOBILE_BROWSER=chromium MOBILE_DEVICE='Pixel 7' MOBILE_PROFILE=low-memory MOBILE_MEMORY_MB=256 playwright test --config=tests/playwright/configs/mobile.config.mjs",
    "dashboard:data": "node activity/cao.mjs",
    "dashboard:data:download": "npm run dashboard:data -- download",
    "generate:agent-catalog": "node scripts/generate-agent-catalog.mjs",
    "dev": "npm run dashboard:local --",
    "docs:dev": "astro dev",
    "docs:build": "astro build && node scripts/validate-agent-docs.mjs && node --test tests/integration/agent-docs-discovery.test.mjs",
    "docs:preview": "astro preview",
    "lint": "node scripts/check-file-sizes.mjs && npm run check:gh-aw-versions && npm run check:agent-plugin && eslint .",
    "check:gh-aw-versions": "node scripts/check-gh-aw-versions.mjs",
    "check:agent-plugin": "node scripts/validate-agent-plugin.mjs",
    "typecheck:cao": "npx tsc -p .github/workflows/shared/tsconfig.json",
    "typecheck:copilot": "tsc --allowJs --noEmit --skipLibCheck --module NodeNext --target ES2022 com.github.copilot/extensions/cao-dashboard/extension.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:unit:area": "node scripts/run-unit-area.mjs",
    "test:conformance:daily-run-counts": "node scripts/run-daily-run-counts-conformance.mjs",
    "test:conformance:statistical-sampling": "node scripts/run-daily-run-counts-conformance.mjs --statistical",
    "test:integration": "node --test --test-concurrency=1 tests/integration/activity-cache.test.mjs tests/integration/activity-session-evidence.test.mjs tests/integration/activity-discovery-cli.test.mjs tests/integration/cao-configuration-cli.test.mjs tests/integration/cao-issue-status.test.mjs tests/integration/cao-operational-value-local.test.mjs tests/integration/control-admission.test.mjs tests/integration/control-failure.test.mjs tests/integration/control-inventory-credentials.test.mjs tests/integration/control-policy-resolver.test.mjs tests/integration/control-standalone-compilation.test.mjs tests/integration/dashboard-bootstrap.test.mjs tests/integration/dashboard-inventory-ingestion.test.mjs tests/integration/dashboard-query-cost.test.mjs",
    "test:campaign-lifecycle": "node --test --test-concurrency=1 tests/integration/campaign-lifecycle.test.mjs",
    "test:campaign-root": "node --test --test-concurrency=1 --test-name-pattern=\"^root campaign bootstraps\" tests/integration/campaign-lifecycle.test.mjs",
    "test:runtime-producer": "node scripts/validate-cao-runtime.mjs",
    "test:runtime-install": "node --test tests/integration/cao-runtime-installation.test.mjs",
    "test:integration:installer": "node --test tests/integration/install-script.test.mjs",
    "runtime:pack": "node scripts/build-cao-runtime.mjs",
    "build:azure-assets": "node scripts/build-cao-azure-assets.mjs",
    "test:load": "node --test tests/load/*.test.mjs",
    "check:svg": "node scripts/check-svg-visual-language.mjs",
    "compile": "gh aw compile --strict --no-emit --no-check-update --schedule-seed githubnext/gh-cao",
    "compile:locks": "gh aw compile --strict --no-check-update --schedule-seed githubnext/gh-cao",
    "check": "npm run lint && npm run typecheck:cao && npm run typecheck:copilot && npm test && npm run test:load && npm run check:svg && npm run dashboard:server:spec:check && npm run compile && npm run docs:build",
    "update-deps": "npx npm-check-updates -u && npm install",
    "test:e2e:docs": "npm run docs:build && playwright test --config=tests/playwright/configs/docs.config.mjs",
    "test:integration:setup-pathways": "go test ./internal/cli -run '^TestNativeSetup' -count=1",
    "test:e2e:setup-pathways": "node scripts/verify-contoso-setup-pathways.mjs --dispatch",
    "test:e2e:setup-pathways:contoso": "node scripts/verify-contoso-setup-pathways.mjs --verify-only",
    "test:e2e:dashboard-views": "playwright test --config=tests/playwright/configs/dashboard-views.config.mjs",
    "test:e2e:dashboard-server": "playwright test --config=tests/playwright/configs/dashboard-server.config.mjs",
    "test:e2e:dashboard-pages": "playwright test --config=tests/playwright/configs/dashboard-pages.config.mjs",
    "test:e2e:cao-mcp-container": "node tests/e2e/cao-mcp-container.mjs",
    "test:e2e:dashboard-query-parity": "node tests/e2e/dashboard-query-parity.mjs",
    "test:e2e:dashboard-deployed": "playwright test --config=tests/playwright/configs/dashboard-deployed.config.mjs",
    "test:performance:dashboard-queries": "playwright test --config=tests/playwright/configs/dashboard-query-performance.config.mjs",
    "test:performance:dashboard-query-cost": "node --expose-gc --test tests/performance/dashboard-query-cost.test.mjs",
    "test:performance:dashboard-query-cost-postgres": "node --test tests/performance/dashboard-query-cost-postgres.test.mjs",
    "test:e2e:dashboard-ingestion": "playwright test --config=tests/playwright/configs/dashboard-ingestion.config.mjs",
    "test:stress:dashboard": "playwright test --config=tests/playwright/configs/dashboard-massive-scale.config.mjs",
    "test:memory:dashboard-overview": "playwright test --config=tests/playwright/configs/dashboard-overview-memory.config.mjs",
    "debug:dashboard-worker-memory": "node tests/e2e/dashboard-worker-memory-trace.mjs --eager --debug=data:indexeddb,data:ingestion,data:performance"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.0",
    "@github/copilot-sdk": "1.0.13",
    "astro": "7.4.2",
    "elkjs": "0.12.0",
    "astro-mermaid": "2.1.0",
    "esbuild": "0.28.2",
    "http-cache-semantics": "file:packages/astro-no-cache",
    "mermaid": "11.17.2",
    "node-pty": "^1.1.0",
    "source-map-js": "file:dashboard/site/packages/source-map-compat",
    "starlight-github-alerts": "0.4.0",
    "starlight-llms-txt": "0.12.0"
  },
  "devDependencies": {
    "@actions/core": "^2.0.3",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^9.1.1",
    "@actions/io": "^2.0.0",
    "@github/local-action": "^7.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@babel/helper-string-parser": "7.29.7",
    "@babel/parser": "7.29.8",
    "@babel/types": "7.29.8",
    "postcss": "8.5.30",
    "rolldown": "1.2.13",
    "astro": {
      "http-cache-semantics": "$http-cache-semantics"
    },
    "mermaid": {
      "katex": "0.18.2"
    },
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    },
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.0",
    "source-map-js": "$source-map-js",
    "starlight-llms-txt": {
      "micromatch": "npm:picomatch@4.0.7"
    },
    "undici": "^6.28.1"
  }
}

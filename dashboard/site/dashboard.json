            "field": "campaign-update-state",
            "title": "Update confidence",
            "display": "status"
          }
        ],
        "actions": [
          {
            "action": "disable-campaign",
            "context": [
              "campaign"
            ],
            "when": {
              "field": "campaign-registration",
              "equals": "true"
            }
          },
          {
            "action": "update-campaign",
            "context": [
              "campaign-source",
              "campaign-name"
            ],
            "when": {
              "field": "campaign-update-action-visible",
              "equals": true
            }
          },
          {
            "action": "enable-campaign",
            "context": [
              "campaign"

{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "central-agentic-ops-dashboard",
    "title": "Central Agentic Ops Dashboard",
    "description": "Authoritative declarative dashboard document for built-in and custom pages in the presenter prototype.",
    "repository": "githubnext/gh-cao",
    "data-status": {
      "freshness-source": "dashboard-data-freshness",
      "health-source": "dashboard-ingestion-health",
      "stale-after-hours": 24
    },
    "callouts": [
      {
        "id": "stale-data",
        "title": "Dashboard data may be stale",
        "description": "No new workflow activity is present in the ingested data for at least 24 hours. Check ingestion and shard details before relying on these results.",
        "icon": "alert",
        "navigation-page": "indexing",
        "visible-when": {
          "source": "dashboard-data-freshness",
          "field": "latest-data-at",
          "older-than-hours": 24
        }
      }
    ],
    "card-templates": [
      {
        "id": "workflow-measurement",
        "icon": "graph",
        "title": { "field": "measurement-label", "title": "Native value" },
        "subtitle": { "field": "measurement-context", "title": "Workflow" },
        "status": { "field": "maturity-status", "title": "Maturity" },
        "labels": [],
        "detail-labels": "visible",
        "details": [
          { "field": "metric-name", "title": "Measure" },
          { "field": "campaign", "title": "Campaign" },
          { "field": "metric-direction", "title": "Goal direction" },
          { "field": "measurement-kind", "title": "Measurement kind" },
          { "field": "coverage-status", "title": "Coverage" },
          { "field": "missing-reason", "title": "Missing evidence" }
        ],
        "timing": [
          { "field": "observed-at", "type": "temporal", "title": "Assessed", "format": "human-friendly-timestamp", "icon": "clock" },
          { "field": "window-end", "type": "temporal", "title": "Evidence through", "format": "human-friendly-timestamp", "icon": "calendar" }
        ]
      },
      {
        "id": "webhook-status",
        "icon": "broadcast",
        "title": { "field": "scope", "title": "Counter scope" },
        "detail-labels": "visible",
        "labels": [{ "field": "configuration", "title": "Configuration" }],
        "details": [
          { "field": "received", "title": "Received" },
          { "field": "in-flight", "title": "In flight" },
          { "field": "verified", "title": "HMAC verified" },
          { "field": "accepted", "title": "Acknowledged" },
          { "field": "rejected", "title": "Rejected" },
          { "field": "failed", "title": "Failed" },
          { "field": "duplicates", "title": "Duplicates" },
          { "field": "pings", "title": "Signed pings" }
        ],
        "timing": [
          { "field": "last-received-at", "title": "Last delivery", "type": "temporal", "format": "human-friendly-timestamp", "icon": "clock" },
          { "field": "last-accepted-at", "title": "Last acknowledgement", "type": "temporal", "format": "human-friendly-timestamp", "icon": "clock" },
          { "field": "last-failure-at", "title": "Last failure", "type": "temporal", "format": "human-friendly-timestamp", "icon": "clock" },
          { "field": "last-ping-at", "title": "Last signed ping", "type": "temporal", "format": "human-friendly-timestamp", "icon": "clock" }
        ]
      },
      {
        "id": "workflow-value-collection",
        "icon": "pulse",
        "title": { "field": "workflow-context", "title": "Workflow" },
        "status": { "field": "collection-state", "title": "Collection" },
        "detail-labels": "visible",
        "labels": [{ "field": "registration", "title": "Registration" }, { "field": "evidence-state", "title": "Evidence" }],
        "details": [
          { "field": "reason", "title": "Reason" },
          { "field": "collector", "title": "Reviewed collector" },
          { "field": "last-attempt-outcome", "title": "Last attempt outcome" }
        ],
        "timing": [
          { "field": "checked-at", "type": "temporal", "format": "human-friendly-timestamp", "title": "Collection checked", "icon": "clock" },
          { "field": "last-attempt-at", "type": "temporal", "format": "human-friendly-timestamp", "title": "Last collector attempt", "icon": "history" },
          { "field": "captured-at", "type": "temporal", "format": "human-friendly-timestamp", "title": "Evidence captured", "icon": "clock" },
          { "field": "evidence-cutoff", "type": "temporal", "format": "human-friendly-timestamp", "title": "Evidence through", "icon": "calendar" }
        ]
      },
      {
        "id": "workflow-value-overview",
        "icon": "trophy",
        "title": { "field": "overview-title", "title": "Workflow" },
        "status": { "field": "trend-movement", "title": "Compared with goal" },
        "detail-labels": "visible",
        "labels": [{ "field": "overview-state", "title": "Collection" }, { "field": "overview-evidence", "title": "Evidence" }],
        "details": [
          { "field": "trend-label", "title": "Observed change" },
          { "field": "trend-measure", "title": "Measure" },
          { "field": "overview-reason", "title": "Collection reason" }
        ],
        "timing": [
          { "field": "overview-captured", "type": "temporal", "format": "human-friendly-timestamp", "title": "Evidence captured", "icon": "clock" },
          { "field": "overview-cutoff", "type": "temporal", "format": "human-friendly-timestamp", "title": "Evidence through", "icon": "calendar" }
        ]
      },
      {
        "id": "workflow-value-result",
        "icon": "trophy",
        "title": { "field": "delta-label", "title": "Observed change" },
        "subtitle": { "field": "workflow-context", "title": "Workflow" },
        "status": { "field": "movement", "title": "Compared with goal" },
        "labels": [],
        "details": [
          { "field": "snapshot-name", "title": "Measure" },
          { "field": "direction-label", "title": "Goal" },
          { "field": "comparison-label", "title": "Reference" }
        ],
        "timing": [{ "field": "observed-at", "type": "temporal", "format": "human-friendly-timestamp", "title": "Evidence captured", "icon": "clock" }]
      },

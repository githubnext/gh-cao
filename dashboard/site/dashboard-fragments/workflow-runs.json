      "views": [
        {
          "id": "workflow-run-health",
          "title": "Run health trend",
          "subject": "Track this workflow's daily observed run conclusions.",
          "objective": "Spot failures or changes in run activity for investigation.",
          "acceptance": "Any apparent trend is checked against underlying runs and data completeness.",
          "description": "Daily conclusions show this workflow's execution health at a glance.",
          "data": {
            "source": "workflow-runs",
            "route-field": "workflow-route"
          },
          "mark": "chart",
          "chart": "line",
          "layout": "full",
          "encoding": {
            "x": {
              "field": "started-at",
              "type": "temporal",
              "format": "human-friendly-timestamp",
              "time-unit": "day"
            },
            "y": {
              "field": "run",
              "type": "quantitative",
              "aggregate": "count"
            },
            "color": {
              "field": "run-conclusion",
              "type": "nominal"
            }
          }
        },
        {
          "id": "workflow-run-duration-cost",
          "title": "Actions minutes and AI Credits",
          "subject": "Timed retained runs and recorded AI Credits for the selected workflow.",
          "objective": "Find runs with high recorded runner time or AI Credits within one workflow and follow their evidence links.",
          "acceptance": "Preserve individual runs without clustering. Circle area shows positive recorded AI Credits, not confidence or verified value. Missing Actions minutes and cost are not inferred as zero; omitted sizes remain disclosed.",
          "description": "Recorded Actions minutes over time, with circle area showing AI Credits and color showing conclusion; missing cost is not zero or complete coverage.",

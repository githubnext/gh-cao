    {
      "id": "workflow-runs",
      "kind": "custom",
      "intent": "Determine which retained run signal needs investigation for the selected workflow.",
      "subject": "Retained runs for the routed workflow in the selected horizon.",
      "objective": "Find concrete execution regressions and runs worth investigating.",
      "acceptance": "Keep status and conclusion distinct; show run links, time bounds and failure-change comparison basis. Missing or partial evidence must not become zero failures or a causal claim.",
      "title": "Workflow runs",
      "description": "Identify retained runs from the selected workflow that require execution investigation.",
      "icon": "play",
      "class-name": "workflow-runs-page",
      "route": {
        "hash-query-parameter": "workflow"

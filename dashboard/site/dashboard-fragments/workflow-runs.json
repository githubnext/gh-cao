  "pages": [
    {
      "id": "workflow-detail",
      "kind": "custom",
      "intent": "Inspect durable reports produced by the selected authored workflow.",
      "subject": "Retained safe-output reports associated with the workflow route parameter.",
      "objective": "Locate report evidence and reviewer disposition before claiming delivery.",
      "acceptance": "Preserve report identity, status, timestamps and provenance links; distinguish no retained reports from unavailable evidence. A published report is not automatically an accepted outcome.",
      "title": "Workflow",
      "description": "Identify durable reports from the selected workflow that require follow-up.",
      "icon": "workflow",
      "class-name": "workflow-detail-page",
      "route": {
        "hash-query-parameter": "workflow"
      },
      "views": [
        {
          "id": "workflow-report-status",
          "title": "Report status",
          "subject": "See the disposition of retained reports for this workflow.",
          "objective": "Identify reports whose durable outputs need follow-up.",
          "acceptance": "Status is verified against source reports and is not equated with verified impact.",
          "description": "The disposition of durable outputs is the leading outcome signal for this workflow.",
          "data": {
            "source": "workflow-reports",
            "route-field": "workflow-route"
          },
          "mark": "chart",

{
  "queries": [
    {
      "name": "workflow-route-record",
      "subject": "Project the selected workflow's identity and registration for its route shell.",
      "objective": "Identify the workflow and its recorded campaign registration before inspecting route-specific evidence.",
      "acceptance": "Preserve organization, repository, workflow identity, recorded role, activation, campaign, rollout mode, and source link; absent registration is not inferred from runs, and displayed activation does not grant execution authority.",
      "from": "workflows",
      "select": [
        { "field": "organization" }, { "field": "repository" }, { "field": "workflow" },
        { "field": "workflow-name" }, { "field": "workflow-role" }, { "field": "workflow-active" },
        { "field": "campaign" }, { "field": "campaign-name" },
        { "field": "rollout-mode" }, { "field": "workflow-link" }
      ]
    },
    {
      "name": "workflow-runtime-health-summary",
      "subject": "Sum daily runtime conclusion counts for the selected workflow.",
      "objective": "Inspect observed dated runs independently of retained detail.",
      "acceptance": "Sum by organization/repository/workflow without adding detail; successful, failed, approval, pending, and other sum to total. Dates use UTC run start; undated evidence is incomplete and missing projection is unavailable. Pending is last-observed state, success is not a verified outcome, and sub-day filters are unsupported.",
      "from": "daily-run-counts",
      "aggregate": {
        "by": ["organization", "repository", "workflow"],
        "values": [
          { "field": "total", "as": "total", "reducer": "sum" },
          { "field": "successful", "as": "successful", "reducer": "sum" },
          { "field": "failed", "as": "failed", "reducer": "sum" },
          { "field": "approval", "as": "approval", "reducer": "sum" },
          { "field": "pending", "as": "pending", "reducer": "sum" },
          { "field": "other", "as": "other", "reducer": "sum" }
        ]
      }
    },
    {
      "name": "workflow-runtime-usage-summary",
      "subject": "Sum retained AI Credits and count telemetry rows for the selected workflow without transferring runs.",
      "objective": "Inspect a workflow's observed AI Credit consumption together with the amount of retained usage telemetry.",
      "acceptance": "AI Credits sum the retained aic values within each organization, repository, and workflow, and telemetry-count counts its usage records; absent telemetry does not establish zero cost or complete run coverage.",
      "from": "usage",
      "compute": [
        { "as": "positive-aic", "function": "greater-than", "args": [{ "field": "aic" }, { "value": 0 }] }
      ],
      "aggregate": {
        "by": ["organization", "repository", "workflow"],
        "values": [
          { "field": "aic", "as": "aic", "reducer": "sum", "filter": { "predicates": [{ "field": "positive-aic", "equals": true }] } },
          { "field": "run", "as": "telemetry-count", "reducer": "count" }
        ]
      }
    },
    {
      "name": "outcome-route-record",
      "subject": "Project the selected safe-output record for the outcome route and its sections.",
      "objective": "Inspect a retained safe output's recorded disposition and follow its durable evidence links.",
      "acceptance": "Preserve safe-output and run identity, title, category, disposition, summary, timestamps, rollout mode, workflow context, and retained links; missing fields stay unknown and a recorded disposition is not independently verified operational impact.",
      "from": "outcomes",
      "select": [
        { "field": "safe-output" }, { "field": "run" }, { "field": "outcome-title" }, { "field": "outcome-number" },
        { "field": "outcome-category" }, { "field": "outcome-status" }, { "field": "outcome-state" },
        { "field": "outcome-summary" },
        { "field": "published-at" }, { "field": "observed-at" }, { "field": "rollout-mode" },
        { "field": "workflow" }, { "field": "workflow-name" }, { "field": "workflow-link" },
        { "field": "external-link" }, { "field": "issue-link" }, { "field": "pull-request-link" }, { "field": "run-link" }
      ]
    },
    {
      "name": "entity-runs",
      "subject": "Project run entities for reusable run cards and workflow drill-down.",
      "objective": "Expose retained run-attempt identity, execution timing, conclusion, and link for a bounded workflow-run inspection.",
      "acceptance": "Keep organization, repository, workflow, run and attempt with status, conclusion, event, branch, duration, timestamps, and run link; missing timing or conclusion remains unknown rather than inferred success.",
      "from": "runs",
      "select": [
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "target-repository"
        },
        {
          "field": "run"
        },
        {
          "field": "run-attempt"
        },
        {
          "field": "run-title"
        },
        {
          "field": "run-status"
        },
        {
          "field": "run-conclusion"
        },
        {
          "field": "event"
        },
        {
          "field": "branch"
        },
        {
          "field": "duration"
        },
        {
          "field": "started-at"
        },
        {
          "field": "ended-at"
        },
        {
          "field": "run-link"
        }
      ],
      "order-by": [
        {
          "field": "started-at",
          "direction": "desc"
        }
      ]
    },
    {
      "name": "workflow-runs",
      "subject": "Project canonical runs into route-addressable workflow run evidence.",
      "objective": "Trace retained runs and recorded failure evidence for a selected workflow route.",
      "acceptance": "Preserve workflow route, run identity, timing, recorded Actions minutes and AI Credits, status, conclusion, failure fields, mode, engine/model metadata, and run link; missing failure details do not prove success or rule out incomplete import.",
      "description": "Workflow runs with a stable repository and workflow route key.",
      "from": "runs",
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "workflow-route",
          "function": "concat",
          "args": [
            {
              "field": "repository-coordinate"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "workflow-route"
        },
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "run"
        },
        {
          "field": "run-title"
        },
        {
          "field": "event"
        },
        {
          "field": "started-at"
        },
        {
          "field": "ended-at"
        },
        { "field": "action-minutes" },
        { "field": "aic-total" },
        {
          "field": "run-status"
        },
        {
          "field": "run-conclusion"
        },
        {
          "field": "failure-job"
        },
        {
          "field": "failure-message"
        },
        {
          "field": "failure-step"
        },
        {
          "field": "failure-log"
        },
        {
          "field": "rollout-mode"
        },
        {
          "field": "engine"
        },
        {
          "field": "engine-version"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "requested-model"
        },
        {
          "field": "resolved-model"
        },
        {
          "field": "run-link"
        }
      ],
      "order-by": [
        {
          "field": "started-at",
          "direction": "desc"
        },
        {
          "field": "run",
          "direction": "desc"
        }
      ]
    },
    {
      "name": "workflow-failure-trend",
      "subject": "Show recent failure counts and their change for each workflow.",
      "objective": "Spot a change in observed workflow failure activity without treating unknown conclusions as failures.",
      "acceptance": "Each observed failure counts once within its own workflow; the first change is undefined and the seven-observation window is not a seven-day calendar interval.",
      "from": "workflow-runs",
      "compute": [
        {
          "as": "is-failure",
          "function": "equals-any",
          "args": [{ "field": "run-conclusion" }, { "value": "failure" }, { "value": "timed_out" }]
        },
        {
          "as": "failure-count",
          "function": "if",
          "args": [{ "field": "is-failure" }, { "value": 1 }, { "value": 0 }]
        }
      ],
      "window": [
        {
          "operation": "rolling",
          "field": "failure-count",
          "as": "recent-failure-count",
          "frame": 7,
          "reducer": "sum",
          "order-by": [
            { "field": "started-at", "direction": "asc" },
            { "field": "run", "direction": "asc" }
          ],
          "groupby": ["workflow-route"]
        },
        {
          "operation": "change",
          "field": "recent-failure-count",
          "as": "failure-count-change",
          "mode": "absolute",
          "order-by": [
            { "field": "started-at", "direction": "asc" },
            { "field": "run", "direction": "asc" }
          ],
          "groupby": ["workflow-route"]
        }
      ]
    },
    {
      "name": "workflow-reports",
      "subject": "Project retained outcomes into route-addressable workflow reports.",
      "objective": "Review retained workflow outcome reports separately from execution status before interpreting operational results.",
      "acceptance": "Keep route, safe output, report title and summary, recorded status, category, observation time, metadata, and external link; missing reports or status do not imply success or no work.",
      "description": "Workflow outcome reports with stable route keys and disposition fields.",
      "from": "outcomes",
      "compute": [
        {
          "as": "report-repository",
          "function": "coalesce",
          "args": [
            {
              "field": "runtime-repository"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "workflow-route",
          "function": "concat",
          "args": [
            {
              "field": "report-repository"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        },
        {
          "as": "report-status",
          "function": "coalesce",
          "args": [
            {
              "field": "outcome-status"
            },
            {
              "field": "outcome-state"
            },
            {
              "value": "unknown"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "workflow-route"
        },
        {
          "field": "safe-output"
        },
        {
          "field": "outcome-title"
        },
        {
          "field": "outcome-summary"
        },
        {
          "field": "report-status",
          "as": "outcome-status"
        },
        {
          "field": "rollout-mode"
        },
        {
          "field": "engine"
        },
        {
          "field": "engine-version"
        },
        {
          "field": "requested-model"
        },
        {
          "field": "resolved-model"
        },
        {
          "field": "outcome-category"
        },
        {
          "field": "observed-at"
        },
        {
          "field": "external-link"
        }
      ],
      "order-by": [
        {
          "field": "observed-at",
          "direction": "desc"
        },
        {
          "field": "outcome-title",
          "direction": "asc"
        }
      ]
    }
  ],
  "views": [

{
  "name": "@central-agentic-ops/dashboard-language-renderer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && node ./scripts/lint-octicons.mjs && npm run validate:dashboards",
    "test": "vitest run --environment jsdom",
    "pretest:e2e": "CAO_DASHBOARD_PROFILE=server node ./scripts/build.mjs dist ../../.github/workflows/cao.json",
    "test:e2e": "npx playwright test --config=playwright.config.mjs",
    "test:performance": "node ./scripts/build.mjs dist test/performance/fixtures/control-settings.json && node ./test/performance/lighthouse.mjs",
    "validate:corpus": "node ./scripts/validate-corpus.mjs",
    "validate:dashboards": "node ./scripts/validate-dashboards.mjs",
    "analyze:dead-views": "node ./scripts/render-dead-views.mjs",
    "analyze:query-graphs": "node ./scripts/validate-dashboards.mjs --render-query-graphs",
    "dev": "npm --prefix ../.. run dev --"
  },
  "overrides": {
    "postcss": "8.5.30",
    "rolldown": "1.2.13",
    "source-map-js": "$source-map-js",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.28.2",
    "strip-ansi": "^7.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "lighthouse": "^13.4.1",
    "puppeteer-core": "^25.10.0",
    "source-map-js": "file:packages/source-map-compat",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  }
}

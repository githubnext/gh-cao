{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/githubnext/gh-cao/main/.github/workflows/shared/cao.schema.json",
  "title": "Central Agentic Ops Policy",
  "description": "Versioned non-secret policy for Central Agentic Ops control and target repositories.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "anyOf": [
    { "required": ["control-plane"] },
    { "required": ["target-authority"] }
  ],
  "allOf": [
    {
      "if": { "required": ["control-plane"] },
      "then": { "required": ["gh-aw-version"] }
    }
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/githubnext/gh-cao/main/.github/workflows/shared/cao.schema.json"
    },
    "version": { "const": 1 },
    "gh-aw-version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "control-plane": { "$ref": "#/$defs/controlPlane" },
    "target-authority": { "$ref": "#/$defs/targetAuthority" }
  },
  "$defs": {
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$"
    },
    "login": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "mode": {
      "type": "string",
      "enum": ["review", "live"]
    },
    "maxRepositories": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "rolloutPercent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "monthlyAiCreditBudget": {
      "type": "integer",
      "minimum": 0
    },
    "octicon": {
      "type": "string",
      "enum": [
        "mark-github", "code", "repo", "server", "issue", "pull-request", "play", "eye",
        "shield", "meter", "graph", "codescan", "dependabot", "key", "beaker", "rocket",
        "workflow", "gear", "check-circle", "goal", "external-link"
      ]
    },
    "workerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow"],
      "properties": {
        "workflow": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "enabled": { "type": "boolean" },
        "max-mode": { "$ref": "#/$defs/mode" }
      }
    },
    "targetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "$ref": "#/$defs/mode" }
      }
    },
    "campaignPolicy": {
      "type": "object",
      "properties": {
        "workflow-values": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "workflow"],
            "allOf": [{
              "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
              "else": { "required": ["collector"] }
            }],
            "properties": {
              "enabled": { "type": "boolean" },
              "repository": { "$ref": "#/$defs/repository" },
              "workflow": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "collector": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+\\.mjs$" },
              "api-requests": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": { "type": "string", "pattern": "^\\.github/value-evidence/(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+\\.jsonl(?:\\.gz)?$" },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            }
          }
        },
        "enabled": { "type": "boolean" },
        "mode": { "$ref": "#/$defs/mode" },
        "max-repositories": { "$ref": "#/$defs/maxRepositories" },
        "rollout-percent": { "$ref": "#/$defs/rolloutPercent" },
        "monthly-ai-credit-budget": { "$ref": "#/$defs/monthlyAiCreditBudget" },
        "icon": { "$ref": "#/$defs/octicon" },
        "deploy": { "type": "boolean" },
        "targets": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/repository" },
          "additionalProperties": { "$ref": "#/$defs/targetPolicy" }
        },
        "workers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": { "$ref": "#/$defs/workerPolicy" }
        }
      },
      "additionalProperties": false
    },
    "controlCampaigns": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "properties": { "activity": { "$ref": "#/$defs/campaignPolicy" } },
      "additionalProperties": {
        "allOf": [
          { "$ref": "#/$defs/campaignPolicy" },
          { "not": { "required": ["workflow-values"] } }
        ]
      }
    },
    "workflowPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "$ref": "#/$defs/mode" },
        "max-mode": { "$ref": "#/$defs/mode" },
        "max-repositories": { "$ref": "#/$defs/maxRepositories" },
        "rollout-percent": { "$ref": "#/$defs/rolloutPercent" },
        "monthly-ai-credit-budget": { "$ref": "#/$defs/monthlyAiCreditBudget" },
        "targets": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/repository" },
          "additionalProperties": { "$ref": "#/$defs/targetPolicy" }
        }
      }
    },
    "controlWorkflows": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/workflowPolicy" }
    },
    "operationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "$ref": "#/$defs/mode" },
        "max-mode": { "$ref": "#/$defs/mode" },
        "max-repositories": { "$ref": "#/$defs/maxRepositories" },
        "targets": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/repository" },
          "additionalProperties": { "$ref": "#/$defs/targetPolicy" }
        }
      }
    },
    "controlOperations": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/operationPolicy" }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed-owners": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/owner" }
        },
        "allowed-repositories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repository" }
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories"],
      "properties": {
        "public-only": {
          "type": "boolean",
          "default": false,
          "description": "Observation-only public repository collection with the built-in workflow token; requires exact repositories and runtime public visibility checks. Restricted evidence remains partial."
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repository" }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "The runtime validator also requires cell-index to be smaller than cell-count.",
      "properties": {
        "max-scan-repositories": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "cell-count": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "cell-index": { "type": "integer", "minimum": 0 },
        "batch-size": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "batch-index": { "type": "integer", "minimum": 0 }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experimental": { "type": "boolean" },
        "host": { "$ref": "#/$defs/host" },
        "favicon": {
          "type": "string",
          "maxLength": 2048,
          "anyOf": [
            { "pattern": "^https://(?![^/?#]*@)[^\\s?#]+$" },
            { "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))\\./[A-Za-z0-9][A-Za-z0-9._/-]*$" }
          ]
        }
      }
    },
    "environmentVariable": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "redisTLS": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["auto", "required", "disabled"] },
        "server-name-env": { "$ref": "#/$defs/environmentVariable" },
        "ca-certificate-env": { "$ref": "#/$defs/environmentVariable" }
      }
    },
    "redisModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "module": {
          "type": "string",
          "enum": [
            "generic", "local", "upstash", "aws-elasticache", "redis-cloud", "gcp-memorystore",
            "railway", "render", "digitalocean"
          ]
        },
        "url-env": { "$ref": "#/$defs/environmentVariable" },
        "host-env": { "$ref": "#/$defs/environmentVariable" },
        "port-env": { "$ref": "#/$defs/environmentVariable" },
        "username-env": { "$ref": "#/$defs/environmentVariable" },
        "password-env": { "$ref": "#/$defs/environmentVariable" },
        "namespace-env": { "$ref": "#/$defs/environmentVariable" },
        "session": { "type": "string", "enum": ["pooled", "serialized"] },
        "isolate-process-namespace": { "type": "boolean" },
        "single-replica": { "type": "boolean" },
        "supports-collection": { "type": "boolean" },
        "allow-private-plaintext": { "type": "boolean" },
        "tls": { "$ref": "#/$defs/redisTLS" }
      },
      "allOf": [{
        "if": { "properties": { "module": { "const": "generic" } } },
        "else": {
          "not": {
            "anyOf": [
              { "required": ["session"] },
              { "required": ["isolate-process-namespace"] },
              { "required": ["single-replica"] },
              { "required": ["supports-collection"] }
            ]
          }
        }
      }]
    },
    "hostTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "module": {
          "type": "string",
          "enum": ["generic", "container", "azure-functions"]
        },
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "authentication": { "type": "string", "enum": ["github-oauth"] },
        "listener": { "type": "string", "enum": ["process", "platform", "external"] },
        "require-https": { "const": true },
        "trust-platform-proxy": { "type": "boolean" },
        "supports-single-replica": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 }
      },
      "allOf": [{
        "if": { "properties": { "module": { "const": "generic" } } },
        "then": { "required": ["authentication", "listener"] },
        "else": {
          "not": {
            "anyOf": [
              { "required": ["authentication"] },
              { "required": ["listener"] },
              { "required": ["require-https"] },
              { "required": ["trust-platform-proxy"] },
              { "required": ["supports-single-replica"] }
            ]
          }
        }
      }]
    },
    "modularHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "not": { "required": ["redis", "operational-store"] },
      "properties": {
        "target": { "$ref": "#/$defs/hostTarget" },
        "redis": { "$ref": "#/$defs/redisModule" },
        "operational-store": { "$ref": "#/$defs/operationalStore" },
        "cors": { "$ref": "#/$defs/hostCORS" }
      },
      "allOf": [{
        "if": {
          "required": ["operational-store"],
          "properties": {
            "operational-store": { "properties": { "backend": { "const": "memory" } } }
          }
        },
        "then": {
          "properties": {
            "target": {
              "required": ["replicas"],
              "properties": { "replicas": { "const": 1 } },
              "oneOf": [
                { "properties": { "module": { "const": "container" } } },
                {
                  "required": ["listener", "supports-single-replica"],
                  "properties": {
                    "module": { "const": "generic" },
                    "listener": { "const": "process" },
                    "supports-single-replica": { "const": true }
                  }
                }
              ]
            }
          }
        }
      }]
    },
    "operationalStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend"],
      "properties": {
        "backend": { "enum": ["redis", "memory", "postgres"] },
        "single-process": { "type": "boolean" },
        "allow-volatile": { "type": "boolean" },
        "namespace-env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "redis": { "$ref": "#/$defs/redisModule" },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url-env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }
          }
        }
      },
      "allOf": [{
        "if": { "properties": { "backend": { "const": "memory" } } },
        "then": {
          "required": ["single-process", "allow-volatile"],
          "properties": {
            "single-process": { "const": true },
            "allow-volatile": { "const": true }
          },
          "not": { "required": ["redis"] }
        },
        "else": {
          "properties": {
            "single-process": { "const": false },
            "allow-volatile": { "const": false }
          }
        }
      }, {
        "if": { "properties": { "backend": { "const": "postgres" } } },
        "then": { "not": { "required": ["redis"] } },
        "else": { "not": { "required": ["postgres"] } }
      }]
    },
    "hostCORS": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Omit for same-origin only. CORS is credential-less: listed origins can never read session-authenticated responses. Origins are exact; wildcards, paths, and plaintext non-loopback origins are rejected.",
      "properties": {
        "allowed-origins": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 2048,
            "anyOf": [
              { "pattern": "^https://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*(?::[0-9]{1,5})?/?$" },
              { "pattern": "^https://\\[[0-9A-Fa-f:.]+\\](?::[0-9]{1,5})?/?$" },
              { "pattern": "^http://(?:localhost|127(?:\\.[0-9]{1,3}){3}|\\[::1\\])(?::[0-9]{1,5})?/?$" }
            ]
          }
        },
        "max-age": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "host": { "$ref": "#/$defs/modularHost" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "$ref": "#/$defs/mode" },
        "max-repositories": { "$ref": "#/$defs/maxRepositories" },
        "rollout-percent": { "$ref": "#/$defs/rolloutPercent" },
        "monthly-ai-credit-budget": { "$ref": "#/$defs/monthlyAiCreditBudget" }
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "control-repositories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repository" }
        },
        "reviewers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/login" }
        }
      },
      "if": {
        "required": ["enabled"],
        "properties": { "enabled": { "const": true } }
      },
      "then": {
        "required": ["reviewers"],
        "properties": { "reviewers": { "minItems": 1 } }
      }
    },
    "marketplaceAuth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "secret"],
          "properties": {
            "type": { "const": "pat" },
            "secret": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "app-id-secret", "private-key-secret", "installation-id-secret"],
          "properties": {
            "type": { "const": "github-app" },
            "app-id-secret": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
            "private-key-secret": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
            "installation-id-secret": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }
          }
        }
      ]
    },
    "marketplaceRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "ref"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "repository": { "$ref": "#/$defs/repository" },
        "path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]*$"
        },
        "ref": { "type": "string", "minLength": 1, "maxLength": 255 },
        "format": { "type": "string", "enum": ["packages", "workflows"], "default": "packages" },
        "api-url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "auth": { "$ref": "#/$defs/marketplaceAuth" }
      }
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registries"],
      "properties": {
        "cache-ttl-seconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
        "registries": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/marketplaceRegistry" }
        }
      }
    },
    "webhookExternalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "event", "resourceUrlPrefix", "scope", "secretEnv", "destinationRepositoryIds", "expiresAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$", "not": { "enum": ["compiler", ".", ".."] } },
        "event": { "enum": ["jira_issue", "linear_issue", "azure_devops_issue"] },
        "resourceUrlPrefix": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://[^?#]+/$" },
        "scope": { "type": "string", "minLength": 1, "maxLength": 256 },
        "collectionId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "secretEnv": { "type": "string", "maxLength": 128, "pattern": "^CAO_GATEWAY_SOURCE_[A-Z0-9_]+$", "not": { "pattern": "_PREVIOUS$" } },
        "destinationRepositoryIds": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "event": { "const": "azure_devops_issue" } } },
          "then": { "required": ["collectionId"] },
          "else": { "not": { "required": ["collectionId"] } }
        }
      ]
    },
    "webhookGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "enabled", "revision", "receivingAppId", "dispatchAppId", "namespace", "artifacts", "grants", "workers"],
      "properties": {
        "version": { "const": 1 },
        "enabled": { "type": "boolean", "default": false },
        "revision": { "type": "integer", "minimum": 1 },
        "receivingAppId": { "type": "integer", "minimum": 1 },
        "dispatchAppId": { "type": "integer", "minimum": 1 },
        "namespace": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "workers": { "type": "integer", "minimum": 1, "maximum": 32 },
        "externalSources": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/webhookExternalSource" } },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositories", "activateSecurity"],
          "properties": {
            "activateSecurity": { "type": "boolean", "default": false },
            "activateCommands": { "type": "boolean", "default": false },
            "activateNotifications": { "type": "boolean", "default": false },
            "serverUrl": { "type": "string", "pattern": "^https://[a-z0-9.-]+(:[1-9][0-9]*)?(/[a-zA-Z0-9._~%+-]+)*$", "default": "https://github.com" },
            "intervalSeconds": { "type": "integer", "minimum": 30, "maximum": 3600, "default": 300 },
            "repositories": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["repository", "repositoryId", "receivingInstallationId", "dispatchInstallationId"],
                "properties": {
                  "repository": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$" },
                  "repositoryId": { "type": "integer", "minimum": 1 },
                  "receivingInstallationId": { "type": "integer", "minimum": 1 },
                  "dispatchInstallationId": { "type": "integer", "minimum": 1 },
                  "allowLabelRemoval": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "projectAssignments": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["projectId", "organizationId", "repositoryId"],
            "properties": {
              "projectId": { "type": "string", "pattern": "^[A-Za-z0-9_+/=-]{1,256}$" },
              "organizationId": { "type": "integer", "minimum": 1 },
              "repositoryId": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "repositoryId", "commitSha", "compilerId"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "repositoryId": { "type": "integer", "minimum": 1 },
              "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
              "compilerId": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        },
        "grants": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subscriptionId", "digest", "sourceInstallationId", "sourceRepositoryId", "sourceOrganizationId", "receivingInstallationId", "destinationInstallationId", "destinationRepositoryId", "dispatchKind", "expiresAt"],
            "properties": {
              "subscriptionId": { "type": "string", "minLength": 1 },
              "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "sourceInstallationId": { "type": "integer", "minimum": 1 },
              "sourceRepositoryId": { "type": "integer", "minimum": 0 },
              "sourceOrganizationId": { "type": "integer", "minimum": 0 },
              "projectIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_+/=-]{1,256}$" } },
              "receivingInstallationId": { "type": "integer", "minimum": 1 },
              "destinationInstallationId": { "type": "integer", "minimum": 1 },
              "destinationRepositoryId": { "type": "integer", "minimum": 1 },
              "dispatchKind": { "enum": ["workflow_dispatch", "repository_dispatch"] },
              "allowVisibilityTransfer": { "type": "boolean", "default": false },
              "expiresAt": { "type": "string", "format": "date-time" },
              "revoked": { "type": "boolean", "default": false }
            }
          }
        },
        "queue": { "type": "object", "description": "Strict bounded QueueOptions contract validated by the gateway at startup; see RFC-033." }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": { "$ref": "#/$defs/scope" },
        "activity": { "$ref": "#/$defs/activity" },
        "inventory": { "$ref": "#/$defs/inventory" },
        "web": { "$ref": "#/$defs/web" },
        "defaults": { "$ref": "#/$defs/defaults" },
        "campaigns": { "$ref": "#/$defs/controlCampaigns" },
        "workflows": { "$ref": "#/$defs/controlWorkflows" },
        "operations": { "$ref": "#/$defs/controlOperations" },
        "publishing": { "$ref": "#/$defs/publishing" },
        "marketplace": { "$ref": "#/$defs/marketplace" },
        "webhook-gateway": { "$ref": "#/$defs/webhookGateway" }
      }
    },
    "targetCampaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority"],
      "properties": {
        "authority": { "$ref": "#/$defs/repository" }
      }
    },
    "targetCampaigns": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": { "$ref": "#/$defs/targetCampaign" }
    },
    "targetAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaigns"],
      "properties": {
        "campaigns": { "$ref": "#/$defs/targetCampaigns" }
      }
    }
  }
}
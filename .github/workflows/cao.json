{
  "$schema": "https://raw.githubusercontent.com/githubnext/gh-cao/main/.github/workflows/shared/cao.schema.json",
  "version": 1,
  "gh-aw-version": "v1.0.1",
  "control-plane": {
    "token-broker": {
      "copilot-requests": {
        "workflows": []
      }
    },
    "scope": {
      "allowed-owners": [
        "githubnext",
        "github"
      ],
      "allowed-repositories": [
        "github/gh-aw",
        "github/gh-aw-firewall",
        "github/gh-aw-mcpg",
        "github/gh-aw-actions",
        "github/gh-aw-threat-detection",
        "githubnext/gh-cao"
      ]
    },
    "activity": {
      "repositories": [
        "github/gh-aw",
        "github/gh-aw-firewall",
        "github/gh-aw-mcpg",
        "github/gh-aw-actions",
        "github/gh-aw-threat-detection",
        "githubnext/gh-cao"
      ]
    },
    "defaults": {
      "max-repositories": 6
    },
    "web": {
      "experimental": true,
      "favicon": "./favicon.svg"
    },
    "marketplace": {
      "cache-ttl-seconds": 300,
      "registries": [
        {
          "id": "official",
          "name": "Official CAO catalog",
          "repository": "githubnext/gh-cao",
          "ref": "main",
          "auth": {
            "type": "pat",
            "secret": "GH_TOKEN"
          }
        },
        {
          "id": "agentics",
          "name": "Agentics workflows",
          "repository": "githubnext/agentics",
          "path": "workflows",
          "format": "workflows",
          "ref": "main",
          "auth": {
            "type": "pat",
            "secret": "GH_TOKEN"
          }
        }
      ]
    },
    "workflows": {
      "daily-repo-status": {
        "enabled": false,
        "mode": "review",
        "max-mode": "review",
        "max-repositories": 1
      }
    },
    "campaigns": {
      "dashboard": {
        "deploy": false
      },
      "uk-ai-advisory": {
        "icon": "eye",
        "workers": {
          "operational-resilience": {
            "workflow": "uk-ai-advisory-operational-resilience"
          }
        }
      },
      "cao-evolution": {
        "icon": "gear",
        "mode": "review",
        "max-repositories": 1,
        "workers": {
          "catalog-advisor": {
            "workflow": "cao-evolution-catalog-advisor"
          },
          "compiler-security": {
            "workflow": "cao-evolution-compiler-security"
          },
          "efficiency": {
            "workflow": "cao-evolution-efficiency"
          },
          "failures-investigator": {
            "workflow": "cao-evolution-failures-investigator"
          },
          "integrity": {
            "workflow": "cao-evolution-integrity"
          },
          "reliability": {
            "workflow": "cao-evolution-reliability"
          }
        }
      },
      "bug-bash": {
        "icon": "rocket",
        "mode": "review",
        "max-repositories": 1,
        "workers": {
          "investigation": {
            "workflow": "bug-bash-investigation",
            "max-mode": "review"
          }
        }
      },
      "dependabot": {
        "icon": "dependabot",
        "mode": "review",
        "max-repositories": 1,
        "rollout-percent": 100,
        "targets": {
          "github/gh-aw": {
            "mode": "live"
          }
        },
        "workers": {
          "update-planner": {
            "workflow": "dependabot-update-planner"
          }
        }
      },
      "dreaming": {
        "icon": "beaker",
        "mode": "review",
        "max-repositories": 1,
        "workers": {
          "agents-md-curator": {
            "workflow": "dreaming-agents-md-curator",
            "max-mode": "review"
          }
        }
      },
      "eu-cra-compliance": {
        "icon": "shield",
        "workers": {
          "scope-classifier": {
            "workflow": "eu-cra-compliance-scope-classifier"
          },
          "security-requirements-auditor": {
            "workflow": "eu-cra-compliance-security-requirements-auditor"
          },
          "supply-chain-sbom-auditor": {
            "workflow": "eu-cra-compliance-supply-chain-sbom-auditor"
          },
          "vulnerability-handling-auditor": {
            "workflow": "eu-cra-compliance-vulnerability-handling-auditor"
          },
          "article-14-reporting-readiness": {
            "workflow": "eu-cra-compliance-article-14-reporting-readiness"
          },
          "conformity-release-evidence": {
            "workflow": "eu-cra-compliance-conformity-release-evidence"
          }
        }
      },
      "eslint-rules": {
        "icon": "codescan",
        "mode": "review",
        "max-repositories": 1,
        "workers": {
          "inventory": {
            "workflow": "eslint-rules-inventory"
          },
          "miner": {
            "workflow": "eslint-rules-miner"
          },
          "refiner": {
            "workflow": "eslint-rules-refiner"
          },
          "applier": {
            "workflow": "eslint-rules-applier"
          },
          "librarian": {
            "workflow": "eslint-rules-librarian"
          }
        }
      },
      "optimization": {
        "icon": "meter",
        "mode": "review",
        "max-repositories": 1,
        "workers": {
          "token-auditor": {
            "workflow": "optimization-token-auditor",
            "max-mode": "review"
          },
          "token-optimizer": {
            "workflow": "optimization-token-optimizer",
            "max-mode": "review"
          }
        }
      },
      "software-development-practices": {
        "icon": "code",
        "workers": {
          "github-well-architected": {
            "workflow": "software-development-practices-github-well-architected"
          },
          "nist-ssdf": {
            "workflow": "software-development-practices-nist-ssdf"
          }
        }
      },
      "repo-assist": {
        "icon": "gear",
        "mode": "review",
        "max-repositories": 1,
        "workers": {
          "issue-triage": {
            "workflow": "repo-assist-issue-triage"
          },
          "issue-fix": {
            "workflow": "repo-assist-issue-fix"
          },
          "maintenance": {
            "workflow": "repo-assist-maintenance"
          },
          "pr-upkeep": {
            "workflow": "repo-assist-pr-upkeep"
          }
        }
      },
      "self-care": {
        "mode": "review",
        "max-repositories": 1,
        "rollout-percent": 100,
        "icon": "check-circle",
        "targets": {
          "githubnext/gh-cao": {
            "mode": "live"
          }
        },
        "workers": {
          "accessibility-checker": {
            "workflow": "self-care-accessibility-checker"
          },
          "agent-discoverability": {
            "workflow": "self-care-agent-discoverability"
          },
          "cli-consistency": {
            "workflow": "self-care-cli-consistency"
          },
          "code-improvement": {
            "workflow": "self-care-code-improvement"
          },
          "dashboard-performance": {
            "workflow": "self-care-dashboard-performance"
          },
          "dashboard-debug-logging": {
            "workflow": "self-care-dashboard-debug-logging"
          },
          "dashboard-data-schema": {
            "workflow": "self-care-dashboard-data-schema"
          },
          "data-acquisition-audit": {
            "workflow": "self-care-data-acquisition-audit"
          },
          "dashboard-language-refactor": {
            "workflow": "self-care-dashboard-language-refactor"
          },
          "dashboard-review": {
            "workflow": "self-care-dashboard-review"
          },
          "docs-build-time-investigator": {
            "workflow": "self-care-docs-build-time-investigator"
          },
          "docs-maintainer": {
            "workflow": "self-care-docs-maintainer"
          },
          "documentation-discoverability": {
            "workflow": "self-care-documentation-discoverability"
          },
          "glossary": {
            "workflow": "self-care-glossary"
          },
          "open-source-failures": {
            "workflow": "self-care-open-source-failures"
          },
          "pages-health": {
            "workflow": "self-care-pages-health"
          },
          "primer-brand-checker": {
            "workflow": "self-care-primer-brand-checker"
          },
          "reactive-ui-expert": {
            "workflow": "self-care-reactive-ui-expert"
          },
          "server-go-logging": {
            "workflow": "self-care-server-go-logging"
          },
          "server-soc2": {
            "workflow": "self-care-server-soc2"
          },
          "specs-maintainer": {
            "workflow": "self-care-specs-maintainer"
          }
        }
      },
      "activity": {
        "workflow-values": [
          {
            "api-requests": 700,
            "collector": ".github/value-collectors/daily-file-diet.mjs",
            "evidence": {
              "path": ".github/value-evidence/daily-file-diet.jsonl.gz",
              "sha256": "9afaf3b49a02c1eda0c634016bae98bf0be0a5c1b63f1ae6c6353b151301d19e"
            },
            "repository": "github/gh-aw",
            "workflow": "daily-file-diet"
          }
        ]
      }
    }
  },
  "target-authority": {
    "campaigns": {
      "self-care": {
        "authority": "githubnext/gh-cao"
      },
      "cao-evolution": {
        "authority": "githubnext/gh-cao"
      },
      "dependabot": {
        "authority": "githubnext/gh-cao"
      }
    }
  }
}

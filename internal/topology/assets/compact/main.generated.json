          },
          "subnetId": {
            "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', format('{0}-vnet', parameters('deploymentName')), 'postgres')]"
          },
          "administratorPassword": {
            "value": "[parameters('postgresAdministratorPassword')]"
          },
          "skuName": {
            "value": "[parameters('postgresSkuName')]"

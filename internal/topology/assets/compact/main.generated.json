              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "virtualNetworkId": {
              "type": "string"
            },
            "subnetId": {
              "type": "string"
            },
            "administratorPassword": {
              "type": "securestring"
            },
            "skuName": {
              "type": "string"
            },
            "skuTier": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.Network/privateDnsZones",
              "apiVersion": "2024-06-01",
              "name": "[format('{0}.private.postgres.database.azure.com', parameters('name'))]",
              "location": "global"
            },
            {
              "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
              "apiVersion": "2024-06-01",
              "name": "[format('{0}/{1}', format('{0}.private.postgres.database.azure.com', parameters('name')), 'dashboard')]",
              "location": "global",
              "properties": {
                "registrationEnabled": false,

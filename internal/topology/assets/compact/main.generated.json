          "skuTier": {
            "value": "[parameters('postgresSkuTier')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.49.2.45890",
              "templateHash": "15950922116570535279"
            }
          },
          "parameters": {
